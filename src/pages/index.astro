---
// src/pages/index.astro — 首页 (Cyber-Tech 全新架构)
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import CompareTable from '../components/CompareTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getRecentArticles } from '../data/articles';
import { brands, getTopBrands } from '../data/brands';
import { getFeaturedTopics } from '../data/topics';

const recentArticles = getRecentArticles(6);
const topBrands = getTopBrands(3);
const featuredTopics = getFeaturedTopics(3);
---

<BaseLayout
  title="2026 机场推荐 科学上网导航 | clash-top"
  description="clash-top 用统一维度实测主流机场：晚高峰速度、ChatGPT / Netflix 解锁、线路架构与真实价格，提供 Clash, Shadowrocket 全平台配置教程 完美解锁 Netflix & ChatGPT 流媒体限制。"
>
  <Header slot="header" currentPath="/" />

  <!-- 1. Hero 极客中心通栏 -->
  <HeroSection />

  <!-- 2. 数据统计指标 -->
  <StatsBar />

  <!-- 3. 核心栏目导航网格 -->
  <FeatureGrid />

  <!-- 4. 热门品牌（云图、瞬云等）实测展示 -->
  <section class="section" style="border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background: rgba(17, 24, 39, 0.4)">
    <div class="container-site">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem">
        <div>
          <span class="badge badge-brand">精选实测</span>
          <h2 class="section-title" style="margin-top: 0.5rem">热门机场排行榜</h2>
          <p class="section-desc">包含云图金融级专线、瞬云 ANYCAST 等热门服务，套餐与链接实时对齐。</p>
        </div>
        <a href="/brands/" class="btn btn-secondary">查看完整品牌库 →</a>
      </div>

      <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr))">
        {topBrands.map(brand => (
          <BrandCard {...brand} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 推荐教程与文章 -->
  <section class="section container-site">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem">
      <div>
        <span class="badge badge-cyan">全平台教程</span>
        <h2 class="section-title" style="margin-top: 0.5rem">Clash & Shadowrocket 配置教程</h2>
        <p class="section-desc">手把手教你订阅导入、分流规则配置，完美解锁 Netflix 与 ChatGPT 限制。</p>
      </div>
      <a href="/blog/" class="btn btn-ghost">全部文章 →</a>
    </div>

    <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr))">
      {recentArticles.map(article => (
        <ArticleCard {...article} />
      ))}
    </div>
  </section>

  <!-- 6. 专题聚合 -->
  <section class="section" style="background: rgba(17, 24, 39, 0.4); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color)">
    <div class="container-site">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem">
        <div>
          <span class="badge badge-brand">系统学习</span>
          <h2 class="section-title" style="margin-top: 0.5rem">按专题系统阅读</h2>
          <p class="section-desc">同主题内容聚合成专题，小白入门到高手进阶循序渐进。</p>
        </div>
        <a href="/topics/" class="btn btn-secondary">全部专题 →</a>
      </div>

      <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr))">
        {featuredTopics.map(topic => (
          <a href={`/topics/${topic.slug}/`} class="card card-hover" style="padding: 1.75rem; text-decoration: none">
            <span class="badge badge-cyan">{topic.articleCount} 篇精选</span>
            <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--text-main); margin-top: 1rem">
              {topic.emoji} {topic.title}
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.7">
              {topic.desc}
            </p>
            <div style="margin-top: 1.25rem; font-size: 0.8125rem; font-weight: 700; color: #c084fc">
              进入专题 →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. 横向对比表格组件 -->
  <CompareTable />

  <!-- 8. 高频问题 FAQ 展区 -->
  <FaqAccordion />

  <!-- 9. 极客 CTA 终极 Banner -->
  <section style="padding-block: 4rem; background: linear-gradient(135deg, rgba(124, 58, 237, 0.2), rgba(6, 182, 212, 0.2)); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color)">
    <div class="container-site" style="text-align: center; max-width: 44rem; margin-inline: auto">
      <span class="badge badge-cyan" style="margin-bottom: 1rem">
        📢 实时情报接收
      </span>
      <h2 style="font-size: 2rem; font-weight: 900; color: #ffffff">
        订阅 Telegram 官方频道
      </h2>
      <p style="margin-top: 1rem; color: var(--text-muted); font-size: 1rem; line-height: 1.8">
        每日零点更新免费节点、跑路预警即时通知、各大机场限时优惠码第一时间发布。
      </p>
      <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap">
        <a href="/tg/" target="_blank" rel="noopener" class="btn btn-primary" style="padding: 0.75rem 2rem; font-size: 1rem">
          📢 立即订阅 TG 频道
        </a>
        <a href="/brands/" class="btn btn-secondary" style="padding: 0.75rem 2rem; font-size: 1rem">
          查看机场排行榜
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
