---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import CompareTable from '../components/CompareTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getRecentArticles } from '../data/articles';
import { brands, getTopBrands } from '../data/brands';
import { getFeaturedTopics } from '../data/topics';

const recentArticles = getRecentArticles(6);
const topBrands = getTopBrands(3);
const featuredTopics = getFeaturedTopics(3);
---

<BaseLayout
  title="机场推荐 2026 — 稳定/便宜/专线机场排行榜 | clash-top"
  description="clash-top 是专注机场推荐的中文测评站：2026机场排行榜、稳定机场推荐、便宜机场、专线机场测评，云图/瞬云等主流机场对比，Clash节点订阅教程，帮你快速找到靠谱机场。"
  keywords="机场推荐,机场推荐2026,2026机场推荐,稳定机场,便宜机场,专线机场,机场排行榜,Clash机场,机场对比,云图机场,瞬云机场,科学上网,翻墙工具,VPN推荐,梯子推荐,IEPL机场,IPLC机场,ChatGPT机场,Netflix解锁,流媒体机场,机场测评,机场购买,机场注册,clash-top,Clash节点,订阅链接"
>
  <Header slot="header" currentPath="/" />

  <!-- 1. Hero -->
  <HeroSection />

  <!-- 2. Stats Bar -->
  <StatsBar />

  <!-- 3. 核心栏目 -->
  <FeatureGrid />

  <!-- 4. 最新文章 -->
  <section class="section" style="background:#fff; border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border)" aria-labelledby="latest-title">
    <div class="container-site">
      <div class="section-row-header">
        <div>
          <p class="section-eyebrow">最新内容</p>
          <h2 class="section-title" id="latest-title">推荐文章</h2>
          <p class="section-desc">最近发布与更新的文章，内容持续补充中。</p>
        </div>
        <a href="/blog/" class="btn btn-ghost" id="latest-more-btn">查看全部 →</a>
      </div>

      <div class="articles-grid">
        {recentArticles.map(article => (
          <ArticleCard {...article} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 专题聚合 -->
  <section class="section container-site" aria-labelledby="topics-title">
    <div class="section-row-header">
      <div>
        <p class="section-eyebrow">专题聚合</p>
        <h2 class="section-title" id="topics-title">按专题系统阅读</h2>
        <p class="section-desc">同一主题的文章聚合成专题，按推荐顺序阅读效率更高。</p>
      </div>
      <a href="/topics/" class="btn btn-ghost" id="topics-more-btn">全部专题 →</a>
    </div>

    <div class="topics-grid">
      {featuredTopics.map(topic => (
        <a href={`/topics/${topic.slug}/`} class="card card-hover topic-card" id={`topic-${topic.slug}`}>
          <div class="topic-orb" aria-hidden="true"></div>
          <span class="badge badge-brand topic-count">{topic.articleCount} 篇内容</span>
          <h3 class="topic-title">
            {topic.emoji} {topic.title}
          </h3>
          <p class="topic-desc">{topic.desc}</p>
          <span class="topic-more">
            进入专题
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 6. 品牌展示 -->
  <section class="section" style="background:#fff; border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border)" aria-labelledby="brands-title">
    <div class="container-site">
      <div class="section-row-header">
        <div>
          <p class="section-eyebrow">品牌库</p>
          <h2 class="section-title" id="brands-title">热门机场一览</h2>
          <p class="section-desc">品牌基础信息、特点与评分集中在一页，方便快速了解。</p>
        </div>
        <a href="/brands/" class="btn btn-ghost" id="brands-more-btn">进入品牌库 →</a>
      </div>

      <div class="brands-grid">
        {topBrands.map(brand => (
          <BrandCard {...brand} />
        ))}
      </div>

      <div style="margin-top:1.5rem; text-align:center">
        <a href="/brands/" class="btn btn-secondary" id="brands-full-btn">查看全部 10+ 家品牌</a>
      </div>
    </div>
  </section>

  <!-- 7. 横向对比 -->
  <CompareTable />

  <!-- 8. FAQ -->
  <FaqAccordion />

  <!-- 9. CTA Banner -->
  <section style="background:linear-gradient(135deg, var(--brand-600), var(--brand-800)); padding-block:3.5rem" aria-labelledby="cta-title">
    <div class="container-site" style="text-align:center">
      <span style="display:inline-flex; align-items:center; gap:.5rem; padding:.3rem .875rem; border-radius:9999px; background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.25); font-size:.8125rem; font-weight:600; color:rgba(255,255,255,.9); margin-bottom:1.25rem">
        <span class="pulse-dot" style="color:#fff" aria-hidden="true"></span>
        TG 频道每日更新
      </span>
      <h2 class="section-title" id="cta-title" style="color:#fff; margin-top:0">
        第一时间获取机场情报
      </h2>
      <p style="color:rgba(255,255,255,.75); max-width:32rem; margin:1rem auto 0; font-size:1rem; line-height:1.75">
        订阅 TG 频道，免费节点每早推送、跑路预警即时通知、优惠码第一时间分享。
      </p>
      <div style="margin-top:2rem; display:flex; justify-content:center; flex-wrap:wrap; gap:.75rem">
        <a href="/tg/" target="_blank" rel="noopener" class="btn" style="background:#fff; color:var(--brand-700); border-color:#fff; font-weight:700; padding:.75rem 1.75rem" id="cta-tg-btn">
          📢 订阅 TG 频道
        </a>
        <a href="/brands/" class="btn" style="background:transparent; color:#fff; border-color:rgba(255,255,255,.4); padding:.75rem 1.75rem" id="cta-brands-btn">
          查看机场排行榜
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
