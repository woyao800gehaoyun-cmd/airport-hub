                  <td style="padding: 1rem; color: var(--text-muted)">以官网为准 (周期订阅)</td>
                  <td style="padding: 1rem"><span class="badge badge-brand">主力使用；全节点 x1 · 高峰满速</span></td>
                  <td style="padding: 1rem; text-align: right">
                    <a href={brand.url} target="_blank" rel="noopener" class="btn btn-primary" style="padding: 0.35rem 0.875rem; font-size: 0.8125rem; background: linear-gradient(135deg, #eab308, #f97316)">购买 ↗</a>
                  </td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border-color)">
                  <td style="padding: 1rem; font-weight: 800; color: var(--text-main)">至尊版</td>
                  <td style="padding: 1rem; font-weight: 900; color: #eab308">¥130.00 / 月</td>
                  <td style="padding: 1rem; font-weight: 700">900GB / 月</td>
