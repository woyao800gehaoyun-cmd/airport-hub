import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrandBySlug } from '../../data/brands';
import { articles } from '../../data/articles';

const brand = getBrandBySlug('guangnianti')!;
const plans = brand.plans!;

const scoreItems = [
  { label: '全 IPLC 专线晚高峰稳定性', score: 9.9 },
  { label: '独享私人专线独立带宽', score: 9.8 },
  { label: 'ChatGPT / Claude 解锁率', score: 9.9 },
  { label: 'Netflix 4K / Disney+ 解锁', score: 9.7 },
  { label: '全节点 1 倍率扣费透明度', score: 9.6 },
  { label: '客服与售后工单响应速度', score: 9.5 },
];

const unlockItems = [
  { name: 'ChatGPT (OpenAI)', icon: '🤖', ok: true },
  { name: 'Claude AI', icon: '✨', ok: true },
  { name: 'Netflix 4K', icon: '🎬', ok: true },
  { name: 'YouTube 4K', icon: '▶️', ok: true },
  { name: 'Disney+', icon: '🏰', ok: true },
  { name: 'TikTok 换区', icon: '🎵', ok: true },
  { name: 'Hulu / HBO', icon: '📺', ok: true },
  { name: 'Gemini Advanced', icon: '♊', ok: true },
