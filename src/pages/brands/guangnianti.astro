      <!-- 面包屑 navigation -->
      <nav aria-label="面包屑" style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1.25rem">
        <a href="/" style="color: var(--text-muted); text-decoration: none">首页</a>
        <span style="margin: 0 0.5rem">›</span>
        <a href="/brands/" style="color: var(--text-muted); text-decoration: none">品牌库</a>
        <span style="margin: 0 0.5rem">›</span>
        <span style="color: var(--text-main); font-weight: 700">光年梯机场深度实测</span>
      </nav>

      <div style="display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap">
        <!-- Logo -->
        <div style="width: 5.5rem; height: 5.5rem; border-radius: 1.25rem; background: linear-gradient(135deg, #eab308, #f97316); display: flex; align-items: center; justify-content: center; font-size: 2.25rem; font-weight: 900; color: #fff; flex-shrink: 0; box-shadow: 0 8px 24px rgba(234, 179, 8, 0.3)">
          光
        </div>

        <!-- 品牌基本信息 -->
        <div style="flex: 1; min-width: 16rem">
          <div style="display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; margin-bottom: 0.5rem">
            <span class="badge badge-amber" style="font-size: 0.75rem">👑 综合实测榜首 · 全 IPLC 专线</span>
            <span class="badge badge-green" style="font-size: 0.75rem">✓ 独享私人专线</span>
            <span class="badge badge-cyan" style="font-size: 0.75rem">✓ 高峰满速 · 1倍率</span>
          </div>
          <h1 style="font-size: 2.25rem; font-weight: 900; color: var(--text-main); line-height: 1.2">光年梯机场 (Guangnianti Airport)</h1>
          <p style="margin-top: 0.5rem; color: var(--text-muted); font-size: 1rem">{brand.tagline}</p>

          <!-- 综合评分 -->
          <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1rem">
            <div style="display: flex; align-items: baseline; gap: 0.25rem">
              <span style="font-size: 3rem; font-weight: 900; color: #eab308; line-height: 1">{brand.score.toFixed(1)}</span>
              <span style="color: var(--text-sub); font-size: 0.9rem"> /10</span>
            </div>
            <div>
              <p style="font-size: 0.75rem; color: var(--text-muted)">编辑部综合实测得分（榜首）</p>
              <div style="display: flex; gap: 0.125rem; margin-top: 0.25rem">
                {Array.from({length:5}).map((_,i) => (
                  <span style="color: #f59e0b; font-size: 1.125rem">★</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 注册直达按钮 -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem; min-width: 12rem">
