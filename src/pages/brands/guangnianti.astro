        <div class="card" style="padding: 2rem; margin-bottom: 2rem; background: var(--bg-card)">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            💰 三、光年梯机场官方套餐与价格对照表
          </h2>
          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem; margin-bottom: 1.5rem">
            光年梯所有套餐均支持以官网为准的周期订阅，价格透明且全部节点保持 1 倍率扣费，无高倍扣费陷阱：
          </p>

          <!-- 桌面端表格 -->
          <div style="overflow-x: auto; margin-bottom: 1.5rem">
            <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem">
              <thead>
                <tr style="border-bottom: 2px solid var(--border-color); background: var(--bg-secondary)">
                  <th style="padding: 0.875rem 1rem">套餐名称</th>
                  <th style="padding: 0.875rem 1rem">价格</th>
                  <th style="padding: 0.875rem 1rem">流量</th>
                  <th style="padding: 0.875rem 1rem">周期/类型</th>
                  <th style="padding: 0.875rem 1rem">核心特点</th>
                  <th style="padding: 0.875rem 1rem; text-align: right">购买链接</th>
                </tr>
