                  <td style="padding: 1rem; text-align: right">
                    <a href={brand.url} target="_blank" rel="noopener" class="btn btn-primary" style="padding: 0.35rem 0.875rem; font-size: 0.8125rem; background: linear-gradient(135deg, #eab308, #f97316)">购买 ↗</a>
                  </td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border-color)">
                  <td style="padding: 1rem; font-weight: 800; color: var(--text-main)">晋级版</td>
