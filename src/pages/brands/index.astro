---
// src/pages/brands/index.astro — 品牌库 (精选云图与瞬云 2 家实测机场)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandCard from '../../components/BrandCard.astro';
import { brands } from '../../data/brands';

const sortedBrands = [...brands].sort((a, b) => a.rank - b.rank);
---

<BaseLayout
  title="机场品牌库 2026 — 云图 / 瞬云实测测评排名 | clash-top"
  description="clash-top 深度实测精选云图金融级专线与瞬云 ANYCAST 高速节点，统一维度评分，速度/解锁/价格全维度对比，帮你找到最靠谱的代理服务。"
  keywords="机场品牌库,机场推荐,云图机场,瞬云机场,机场测评,机场排行榜,机场对比,Clash机场,ChatGPT机场,Netflix解锁机场"
>
  <Header slot="header" currentPath="/brands/" />

  <!-- ══ Page Hero ══ -->
  <section class="page-hero">
    <div class="container-site">
      <!-- 标题区 -->
      <div style="max-width: 44rem">
        <div class="hero-pill-badge" style="margin-bottom: 1rem">
          <span class="pulse-dot" style="color: var(--brand-cyan)" aria-hidden="true"></span>
          <span>独立编辑团队真实自费实测</span>
        </div>
        <h1 class="page-hero-title">机场品牌库</h1>
        <p class="page-hero-desc">
          严格精选收录 {brands.length} 家核心主流实测机场，统一维度评分，拒绝广告营销套路，帮你快速找到靠谱服务。
        </p>
      </div>

      <!-- 统计行 -->
      <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem">
        {[
          { val: `${brands.length} 家`, lab: '精选收录' },
          { val: '12 项', lab: '评测维度' },
          { val: '每周', lab: '数据复核' },
          { val: '真实', lab: '自费实测' },
        ].map(s => (
          <div>
            <span style="font-size: 1.375rem; font-weight: 900; color: var(--brand-primary)">{s.val}</span>
            <span style="font-size: 0.875rem; color: var(--text-muted); margin-left: 0.375rem">{s.lab}</span>
          </div>
        ))}
      </div>

      <!-- 筛选 Tab -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 2rem" id="brand-filters" role="tablist">
        {[
          { label: '全部', filter: 'all', icon: '🏠' },
          { label: '主推', filter: '主推', icon: '🥇' },
          { label: '次推', filter: '次推', icon: '🥈' },
          { label: 'AI 解锁', filter: 'AI 解锁', icon: '🤖' },
          { label: '专线', filter: '专线', icon: '⚡' },
        ].map((tab, i) => (
          <button
            class={`brand-filter-pill${i === 0 ? ' active' : ''}`}
            data-filter={tab.filter}
            id={`filter-${tab.filter}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            style={`display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.45rem 1rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 700; border: 1px solid var(--border-color); cursor: pointer; transition: all .2s; ${i===0?'background: var(--brand-primary); color: #fff; border-color: var(--brand-primary)':'background: var(--bg-card); color: var(--text-muted)'}`}
          >
            <span>{tab.icon}</span>
            <span>{tab.label}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 品牌卡片网格 ══ -->
  <section class="section container-site" aria-label="机场品牌列表">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem">
      <div style="height: 1px; flex: 1; background: var(--border-color)"></div>
      <span style="font-size: 0.8125rem; font-weight: 700; color: var(--text-sub); white-space: nowrap">精选共 {brands.length} 家实测机场</span>
      <div style="height: 1px; flex: 1; background: var(--border-color)"></div>
    </div>

    <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr))" id="brands-grid">
      {sortedBrands.map(brand => (
        <div
          data-tags={brand.tags.join(',')}
          data-rank-label={brand.rankLabel}
          class="brand-grid-item"
          style="position: relative"
        >
          <div style="position: absolute; top: -10px; left: 1rem; z-index: 1; background: linear-gradient(135deg, #16a34a, #15803d); color: #fff; font-size: 0.65rem; font-weight: 800; padding: 0.2rem 0.625rem; border-radius: 9999px; letter-spacing: 0.04em; box-shadow: 0 2px 6px rgba(22, 163, 74, 0.3)">
            ✓ 已自费实测验证
          </div>
          <BrandCard {...brand} />
        </div>
      ))}
    </div>

    <!-- 空状态 -->
    <div id="brands-empty" style="display: none; text-align: center; padding: 4rem 2rem; color: var(--text-muted)">
      <div style="font-size: 3rem" aria-hidden="true">🔍</div>
      <p style="margin-top: 1rem; font-size: 1.125rem; font-weight: 700; color: var(--text-main)">暂无符合条件的机场</p>
      <p style="margin-top: 0.5rem; font-size: 0.875rem">请尝试切换为「全部」筛选条件</p>
    </div>
  </section>

  <!-- ══ 评测说明 ══ -->
  <section style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); padding-block: 3.5rem">
    <div class="container-site">
      <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); max-width: 56rem; margin: 0 auto">
        {[
          { icon: '🔬', title: '真实自费购买', desc: '编辑团队自费购买正式套餐，与普通用户相同体验。' },
          { icon: '📡', title: '三网实测数据', desc: '电信 / 联通 / 移动三网实测，晚高峰时段（20-23 点）为准。' },
          { icon: '🔄', title: '每周复核更新', desc: '价格与套餐信息每周手动核实，拒绝过期过时数据。' },
          { icon: '🚫', title: '不接受虚假付费推广', desc: '排名基于真实体验，坚决下架低质跑路跑路盘。' },
        ].map(item => (
          <div style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.25rem; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border-color)">
            <span style="font-size: 1.5rem; flex-shrink: 0">{item.icon}</span>
            <div>
              <p style="font-size: 0.9375rem; font-weight: 700; color: var(--text-main)">{item.title}</p>
              <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.25rem; line-height: 1.6">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // 筛选交互
  const pills = document.querySelectorAll<HTMLElement>('.brand-filter-pill');
  const items = document.querySelectorAll<HTMLElement>('.brand-grid-item');
  const empty = document.getElementById('brands-empty');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => {
        p.classList.remove('active');
        p.style.background = 'var(--bg-card)';
        p.style.color = 'var(--text-muted)';
        p.style.borderColor = 'var(--border-color)';
        p.setAttribute('aria-selected', 'false');
      });
      pill.classList.add('active');
      pill.style.background = 'var(--brand-primary)';
      pill.style.color = '#fff';
      pill.style.borderColor = 'var(--brand-primary)';
      pill.setAttribute('aria-selected', 'true');

      const filter = pill.dataset.filter ?? 'all';
      let visible = 0;

      items.forEach(item => {
        const tags = item.dataset.tags ?? '';
        const rankLabel = item.dataset.rankLabel ?? '';
        const show = filter === 'all' || tags.includes(filter) || rankLabel.includes(filter);
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
