---
// src/pages/brands/shunyun.astro — 瞬云机场详情页（视觉重制版）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrandBySlug } from '../../data/brands';

const brand = getBrandBySlug('shunyun')!;
const plans = brand.plans!;

const scoreItems = [
  { label: '速度稳定性', score: 8.8 },
  { label: 'YouTube 高清', score: 9.0 },
  { label: '节点质量', score: 8.7 },
  { label: '延迟表现', score: 8.9 },
  { label: '性价比', score: 9.2 },
  { label: '稳定性', score: 8.6 },
];

const unlockItems = [
  { name: 'YouTube', icon: '▶️', ok: true },
  { name: 'TikTok', icon: '🎵', ok: true },
  { name: 'Google', icon: '🔍', ok: true },
  { name: 'Twitter/X', icon: '🐦', ok: true },
  { name: 'Instagram', icon: '📷', ok: true },
  { name: 'Telegram', icon: '✈️', ok: true },
  { name: 'ChatGPT', icon: '🤖', ok: false },
  { name: 'Netflix', icon: '🎬', ok: false },
];
---

<BaseLayout
  title="瞬云机场测评 2026 — ANYCAST高速节点 不限速 | clash-top"
  description="瞬云机场深度测评：ANYCAST高速节点，不限速，主流国家全覆盖，行者¥20/月150G，纵横¥36/月300G，流量每月重置，三年折扣25%，个人用户性价比首选。"
  keywords="瞬云机场,瞬云机场评测,瞬云机场注册,ANYCAST机场,不限速机场,高速机场,性价比机场"
>
  <Header slot="header" currentPath="/brands/" />

  <!-- ═══ 顶部品牌 Banner ═══ -->
  <section style="background:linear-gradient(135deg,#ecfeff 0%,#f0fdf4 100%); padding-block:2.5rem 0; border-bottom:1px solid var(--color-border)">
    <div class="container-site">
      <!-- 面包屑 -->
      <nav aria-label="面包屑" style="font-size:.8125rem;color:var(--slate-400);margin-bottom:1.25rem">
        <a href="/" style="color:var(--slate-400);text-decoration:none">首页</a>
        <span style="margin:0 .5rem">›</span>
        <a href="/brands/" style="color:var(--slate-400);text-decoration:none">品牌库</a>
        <span style="margin:0 .5rem">›</span>
        <span style="color:var(--slate-700);font-weight:600">瞬云</span>
      </nav>

      <div style="display:flex;align-items:flex-start;gap:1.5rem;flex-wrap:wrap">
        <!-- Logo -->
        <div style="width:5rem;height:5rem;border-radius:1.25rem;background:linear-gradient(135deg,var(--accent-500),#0891b2);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:900;color:#fff;flex-shrink:0;box-shadow:0 8px 24px rgba(6,182,212,.25)">
          瞬
        </div>

        <!-- 品牌信息 -->
        <div style="flex:1;min-width:16rem">
          <div style="display:flex;align-items:center;gap:.625rem;flex-wrap:wrap;margin-bottom:.5rem">
            <span style="background:linear-gradient(135deg,#94a3b8,#64748b);color:#fff;font-size:.75rem;font-weight:800;padding:.25rem .875rem;border-radius:9999px">🥈 次推机场</span>
            <span style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;font-size:.75rem;font-weight:600;padding:.2rem .75rem;border-radius:9999px">✓ 库存充足</span>
            <span style="background:#ecfeff;color:#0e7490;border:1px solid #a5f3fc;font-size:.75rem;font-weight:600;padding:.2rem .75rem;border-radius:9999px">✓ ANYCAST 高速</span>
            <span style="background:#ecfeff;color:#0e7490;border:1px solid #a5f3fc;font-size:.75rem;font-weight:600;padding:.2rem .75rem;border-radius:9999px">✓ 不限速</span>
          </div>
          <h1 style="font-size:2rem;font-weight:900;color:var(--slate-900);line-height:1.2">瞬云机场</h1>
          <p style="margin-top:.5rem;color:var(--slate-500);font-size:.9375rem">{brand.tagline}</p>

          <!-- 综合分数 -->
          <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem">
            <div style="display:flex;align-items:baseline;gap:.25rem">
              <span style="font-size:3rem;font-weight:900;color:var(--accent-600);line-height:1">{brand.score.toFixed(1)}</span>
              <span style="color:var(--slate-400);font-size:.9rem">/10</span>
            </div>
            <div>
              <p style="font-size:.75rem;color:var(--slate-400)">综合评分</p>
              <div style="display:flex;gap:.125rem;margin-top:.25rem">
                {Array.from({length:5}).map((_,i) => (
                  <span style={`color:${i < Math.round(brand.score/2) ? '#f59e0b' : 'var(--slate-200)'};font-size:1.125rem`}>★</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- CTA 按钮组 -->
        <div style="display:flex;flex-direction:column;gap:.75rem;min-width:10rem">
          <a href={brand.url} target="_blank" rel="noopener nofollow sponsored" id="shunyun-top-cta"
            style="display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.875rem 1.75rem;background:linear-gradient(135deg,var(--accent-500),#0891b2);color:#fff;border-radius:.75rem;font-weight:800;font-size:1rem;text-decoration:none;box-shadow:0 4px 16px rgba(6,182,212,.35);transition:all .2s"
            onmouseover="this.style.transform='translateY(-2px)'"
            onmouseout="this.style.transform=''"
          >
            🚀 立即注册瞬云
          </a>
          <a href="/compare/" id="shunyun-compare-link"
            style="display:flex;align-items:center;justify-content:center;padding:.75rem;border:1.5px solid #a5f3fc;border-radius:.75rem;color:var(--accent-600);font-weight:600;font-size:.875rem;text-decoration:none;background:white;transition:all .2s"
            onmouseover="this.style.background='#ecfeff'"
            onmouseout="this.style.background='white'"
          >
            与其他机场对比
          </a>
        </div>
      </div>

      <!-- Tab 导航 -->
      <div style="display:flex;gap:0;margin-top:2rem;border-bottom:2px solid var(--color-border)">
        {['套餐价格','功能解锁','综合评分','评测详情'].map((tab, i) => (
          <button
            onclick={`showTabS(${i})`}
            id={`stab-btn-${i}`}
            style={`padding:.75rem 1.25rem;background:none;border:none;font-size:.875rem;font-weight:700;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s;${i===0?'color:var(--accent-600);border-bottom-color:var(--accent-500)':'color:var(--slate-400)'}`}
          >{tab}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 主内容区 ═══ -->
  <div class="container-site" style="padding-block:2.5rem">
    <div style="display:grid;gap:2rem;grid-template-columns:1fr min(20rem,100%);align-items:start" class="detail-layout">

      <!-- 左侧主内容 -->
      <div>

        <!-- ── 套餐价格 ── -->
        <div id="ssection-0">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:var(--accent-500);color:#fff;font-size:.875rem;align-items:center;justify-content:center">¥</span>
            套餐价格
          </h2>

          <div style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));max-width:44rem">
            {plans.map((plan, i) => (
              <div style={`border-radius:1rem;overflow:hidden;border:${i===1?'2px solid var(--accent-400)':'1px solid var(--color-border)'};background:#fff;box-shadow:${i===1?'0 8px 32px rgba(6,182,212,.15)':'0 2px 8px rgba(0,0,0,.06)'};transition:transform .2s,box-shadow .2s`}
                onmouseover="this.style.transform='translateY(-4px)'"
                onmouseout="this.style.transform=''"
              >
                {i===1 && <div style="background:linear-gradient(135deg,var(--accent-500),#0891b2);color:#fff;text-align:center;font-size:.7rem;font-weight:800;padding:.35rem;letter-spacing:.06em">⚡ 更多流量</div>}

                <div style="padding:1.5rem">
                  <div style="display:flex;align-items:center;justify-content:space-between">
                    <span style="font-size:1.125rem;font-weight:800;color:var(--slate-900)">{plan.name}</span>
                    <span style="display:inline-flex;align-items:center;gap:.375rem;font-size:.72rem;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #bbf7d0;padding:.2rem .625rem;border-radius:9999px">
                      <span style="width:.4rem;height:.4rem;border-radius:50%;background:#16a34a;animation:pulse 2s infinite"></span>
                      库存充足
                    </span>
                  </div>

                  <!-- 价格 -->
                  <div style="margin-top:1.25rem;display:flex;align-items:baseline;gap:.375rem">
                    <span style="font-size:.875rem;color:var(--slate-500);font-weight:600">¥</span>
                    <span style="font-size:2.75rem;font-weight:900;color:var(--slate-900);line-height:1">{plan.price}</span>
                    <span style="font-size:.875rem;color:var(--slate-400)">.00 / 月付</span>
                  </div>

                  <!-- 周期选项 -->
                  <div style="display:flex;flex-wrap:wrap;gap:.375rem;margin-top:1rem">
                    {['月付','季度','半年','一年','两年','三年'].map((p, pi) => (
                      <span style={`padding:.25rem .625rem;border-radius:.375rem;font-size:.7rem;font-weight:600;${pi===0?'background:#ecfeff;color:var(--accent-700);border:1.5px solid #a5f3fc':'background:var(--slate-50);color:var(--slate-500);border:1px solid var(--slate-200)'}`}>
                        ✓ {p}
                      </span>
                    ))}
                    <span style="padding:.25rem .625rem;border-radius:.375rem;font-size:.7rem;font-weight:600;background:var(--slate-50);color:var(--slate-300);border:1px solid var(--slate-200);text-decoration:line-through">
                      × 一次性
                    </span>
                  </div>

                  <!-- 折扣提示 -->
                  <div style="margin-top:1rem;padding:.625rem .875rem;background:#ecfeff;border-radius:.5rem;border-left:3px solid var(--accent-500)">
                    <p style="font-size:.78rem;color:#0e7490;font-weight:600">{plan.highlight}</p>
                  </div>

                  <!-- 分割线 -->
                  <div style="border-top:1px solid var(--slate-100);margin:.875rem 0"></div>

                  <!-- 特色权益 -->
                  <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
                    {plan.features.map(f => (
                      <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.8rem;color:var(--slate-600);line-height:1.5">
                        <span style="color:#0e7490;flex-shrink:0;margin-top:.1rem">•</span>
                        {f}
                      </li>
                    ))}
                  </ul>

                  <!-- 购买按钮 -->
                  <a href={brand.url} target="_blank" rel="noopener nofollow sponsored"
                    id={`shunyun-plan-${i}-btn`}
                    style={`display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:1.25rem;padding:.75rem;border-radius:.625rem;font-weight:700;font-size:.9rem;text-decoration:none;transition:all .2s;${i===1?'background:linear-gradient(135deg,var(--accent-500),#0891b2);color:#fff;box-shadow:0 4px 12px rgba(6,182,212,.3)':'background:#ecfeff;color:var(--accent-600);border:1.5px solid #a5f3fc'}`}
                    onmouseover="this.style.transform='translateY(-1px)'"
                    onmouseout="this.style.transform=''"
                  >
                    🛒 购买{plan.name}套餐
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── 功能解锁 ── -->
        <div id="ssection-1" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:#16a34a;color:#fff;font-size:.875rem;align-items:center;justify-content:center">✓</span>
            功能解锁
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.5rem">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(10rem,1fr));gap:.875rem">
              {unlockItems.map(item => (
                <div style={`display:flex;align-items:center;gap:.75rem;padding:.875rem;border-radius:.75rem;border:1px solid;${item.ok?'background:#f0fdf4;border-color:#bbf7d0':'background:var(--slate-50);border-color:var(--slate-200)'}`}>
                  <span style="font-size:1.5rem">{item.icon}</span>
                  <div>
                    <p style={`font-size:.875rem;font-weight:700;${item.ok?'color:#15803d':'color:var(--slate-400)'}`}>{item.name}</p>
                    <p style={`font-size:.7rem;${item.ok?'color:#16a34a':'color:var(--slate-400)'}`}>{item.ok?'✓ 已解锁':'✗ 不支持'}</p>
                  </div>
                </div>
              ))}
            </div>
            <div style="margin-top:1rem;padding:.875rem 1rem;background:#fffbeb;border-radius:.5rem;border:1px solid #fde68a">
              <p style="font-size:.8125rem;color:#92400e;font-weight:600">
                ⚠️ 瞬云主要适合日常科学上网、YouTube 高清观看，ChatGPT 等 AI 工具解锁效果一般，有 AI 需求建议选择云图。
              </p>
            </div>
          </div>
        </div>

        <!-- ── 综合评分 ── -->
        <div id="ssection-2" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:#f59e0b;color:#fff;font-size:.875rem;align-items:center;justify-content:center">★</span>
            综合评分
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.5rem;display:flex;flex-direction:column;gap:1rem">
            {scoreItems.map(item => (
              <div style="display:flex;align-items:center;gap:1rem">
                <span style="font-size:.875rem;font-weight:600;color:var(--slate-600);width:7rem;flex-shrink:0">{item.label}</span>
                <div style="flex:1;height:8px;background:var(--slate-100);border-radius:4px;overflow:hidden">
                  <div style={`height:100%;border-radius:4px;background:${item.score>=9?'linear-gradient(90deg,#0891b2,var(--accent-400))':'linear-gradient(90deg,#f59e0b,#fbbf24)'};width:${item.score*10}%`}></div>
                </div>
                <span style={`font-size:.9375rem;font-weight:800;width:2.5rem;text-align:right;${item.score>=9?'color:var(--accent-600)':'color:var(--slate-600)'}`}>{item.score}</span>
              </div>
            ))}
            <div style="border-top:2px solid var(--slate-100);padding-top:1rem;display:flex;align-items:center;justify-content:space-between">
              <span style="font-size:1rem;font-weight:700;color:var(--slate-700)">综合评分</span>
              <div style="display:flex;align-items:baseline;gap:.25rem">
                <span style="font-size:2.5rem;font-weight:900;color:var(--accent-600)">{brand.score.toFixed(1)}</span>
                <span style="color:var(--slate-400)">/10</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ── 评测详情 ── -->
        <div id="ssection-3" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:var(--accent-500);color:#fff;font-size:.875rem;align-items:center;justify-content:center">📋</span>
            评测详情
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;overflow:hidden">
            {[
              { icon: '⚡', title: '速度 & 稳定性', color: '#0891b2', bg: '#ecfeff', content: '瞬云采用主流国家 ANYCAST 高速节点，实测 YouTube 4K 无缓冲，延迟表现优秀。不限速是最大亮点，带宽跑满不限制，适合大流量用户。白天和晚高峰差异较小。' },
              { icon: '🌍', title: '节点覆盖', color: '#0891b2', bg: '#ecfeff', content: '覆盖美国、日本、香港、新加坡、英国、德国、澳大利亚等主流国家和地区，ANYCAST 智能路由，自动选择最优节点，无需手动切换。' },
              { icon: '🔄', title: '流量 & 设备', color: '#16a34a', bg: '#f0fdf4', content: '流量每月重置，不累计不结转。仅限个人使用（不支持共享账号），带宽不限速。行者套餐 150G/月，纵横套餐 300G/月，满足普通到中度用户需求。' },
              { icon: '💰', title: '价格 & 性价比', color: '#d97706', bg: '#fffbeb', content: '行者 ¥20/月（150G）、纵横 ¥36/月（300G），性价比极高。支持月付到三年多种周期，三年套餐折扣约 25%。特殊商品不支持退换，建议先月付体验。' },
              { icon: '⚠️', title: '注意事项', color: '#d97706', bg: '#fffbeb', content: '仅限个人使用，不支持账号共享；特殊商品不支持退换，建议先买月付体验；主要适合日常科学上网，ChatGPT/Netflix 解锁效果一般，有高级解锁需求建议选云图。' },
            ].map(block => (
              <div style="border-bottom:1px solid var(--color-border)">
                <div style="padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:1rem">
                  <div style={`width:2.5rem;height:2.5rem;border-radius:.75rem;background:${block.bg};display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0`}>
                    {block.icon}
                  </div>
                  <div>
                    <h3 style={`font-size:.9375rem;font-weight:700;color:${block.color};margin-bottom:.375rem`}>{block.title}</h3>
                    <p style="font-size:.8125rem;color:var(--slate-600);line-height:1.75">{block.content}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- 右侧边栏 -->
      <aside style="position:sticky;top:5rem;display:flex;flex-direction:column;gap:1rem">
        <!-- 快速信息卡 -->
        <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem">
          <h3 style="font-size:.875rem;font-weight:700;color:var(--slate-700);margin-bottom:1rem;padding-bottom:.625rem;border-bottom:1px solid var(--slate-100)">机场基本信息</h3>
          <ul style="display:flex;flex-direction:column;gap:.75rem;list-style:none">
            {[
              { label: '品牌名称', val: '瞬云机场' },
              { label: '起步价格', val: '¥20 / 月' },
              { label: '线路类型', val: 'ANYCAST 高速' },
              { label: '支持协议', val: 'ANYCAST' },
              { label: '最大设备数', val: '1 台（个人）' },
              { label: '流量重置', val: '每月重置' },
              { label: '带宽限制', val: '不限速 ✓' },
              { label: '综合评分', val: `${brand.score} / 10` },
              { label: '推荐级别', val: '🥈 次推' },
            ].map(item => (
              <li style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;font-size:.8125rem">
                <span style="color:var(--slate-400)">{item.label}</span>
                <span style="font-weight:700;color:var(--slate-800);text-align:right">{item.val}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 注册入口 -->
        <div style="background:linear-gradient(135deg,var(--accent-500),#0891b2);border-radius:1rem;padding:1.5rem;text-align:center">
          <p style="color:rgba(255,255,255,.85);font-size:.8rem;margin-bottom:.625rem">使用推荐链接注册</p>
          <a href={brand.url} target="_blank" rel="noopener nofollow sponsored" id="shunyun-sidebar-cta"
            style="display:block;background:#fff;color:var(--accent-700);font-weight:800;padding:.875rem;border-radius:.625rem;text-decoration:none;font-size:.9375rem;transition:all .2s"
            onmouseover="this.style.background='#ecfeff'"
            onmouseout="this.style.background='#fff'"
          >
            🚀 立即注册瞬云
          </a>
          <p style="margin-top:.75rem;color:rgba(255,255,255,.6);font-size:.7rem">行者 ¥20 起 · 不限速</p>
        </div>

        <!-- 和云图对比提示 -->
        <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:1rem;padding:1.25rem">
          <p style="font-size:.8125rem;font-weight:700;color:#92400e;margin-bottom:.5rem">💡 需要 AI 解锁？</p>
          <p style="font-size:.75rem;color:#92400e;line-height:1.6;margin-bottom:.875rem">ChatGPT / Claude 解锁建议选择云图机场，金融级专线 + 原生 IP，AI 工具解锁效果更好。</p>
          <a href="/brands/yuntu/" id="shunyun-yuntu-link"
