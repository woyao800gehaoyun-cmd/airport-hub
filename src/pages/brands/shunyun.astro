<script>
  function showTabS(i: number) {
    const el = document.getElementById(`ssection-${i}`);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    for (let j = 0; j < 4; j++) {
      const btn = document.getElementById(`stab-btn-${j}`);
      if (btn) {
        (btn as HTMLElement).style.color = j === i ? 'var(--accent-600)' : 'var(--slate-400)';
        (btn as HTMLElement).style.borderBottomColor = j === i ? 'var(--accent-500)' : 'transparent';
      }
    }
  }
  (window as any).showTabS = showTabS;
</script>
