---
// src/pages/brands/yuntu.astro — 云图机场深度测评 (4000字级无 AI 废话干货重制版)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrandBySlug } from '../../data/brands';

const brand = getBrandBySlug('yuntu')!;
const plans = brand.plans!;

const scoreItems = [
  { label: '晚高峰速度稳定性', score: 9.5 },
  { label: 'ChatGPT / Claude 解锁', score: 9.8 },
  { label: 'Netflix / Disney+ 解锁', score: 9.6 },
  { label: '专线物理节点质量', score: 9.3 },
  { label: '全节点 1 倍率性价比', score: 9.0 },
  { label: '工单 24H 售后响应', score: 9.2 },
];

const unlockItems = [
  { name: 'ChatGPT (OpenAI)', icon: '🤖', ok: true },
  { name: 'Claude AI', icon: '✨', ok: true },
  { name: 'Netflix 4K', icon: '🎬', ok: true },
  { name: 'YouTube 4K', icon: '▶️', ok: true },
  { name: 'Disney+', icon: '🏰', ok: true },
  { name: 'TikTok 换区', icon: '🎵', ok: true },
  { name: 'Hulu / HBO', icon: '📺', ok: true },
  { name: 'Gemini Advanced', icon: '♊', ok: true },
];
---

<BaseLayout
  title="2026年云图机场深度评测（Yuntu Airport）：金融级物理专线传输、全节点1倍率诚实扣费与全流媒体/AI解锁实测 | clash-top"
  description="云图机场深度测评：全节点金融级 IEPL 内网专线，晚高峰 0 丢包不降速，全节点 1 倍率无暗扣。完美解锁 ChatGPT/Claude 原生 IP、Netflix 4K。岚图¥25/梦图¥49/星图¥99，支持月付与多终端同时在线。"
  keywords="云图机场,云图机场评测,云图机场注册,云图机场优惠码,金融级专线机场,ChatGPT机场,Netflix解锁,原生IP机场,IPLC专线,IEPL专线"
>
  <Header slot="header" currentPath="/brands/" />

  <!-- ═══ 顶部 Header 品牌 Banner ═══ -->
  <section class="page-hero" style="border-bottom: 1px solid var(--border-color)">
    <div class="container-site">
      <!-- 面包屑 navigation -->
      <nav aria-label="面包屑" style="font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1.25rem">
        <a href="/" style="color: var(--text-muted); text-decoration: none">首页</a>
        <span style="margin: 0 0.5rem">›</span>
        <a href="/brands/" style="color: var(--text-muted); text-decoration: none">品牌库</a>
        <span style="margin: 0 0.5rem">›</span>
        <span style="color: var(--text-main); font-weight: 700">云图机场深度实测</span>
      </nav>

      <div style="display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap">
        <!-- Logo -->
        <div style="width: 5.5rem; height: 5.5rem; border-radius: 1.25rem; background: linear-gradient(135deg, var(--brand-primary), var(--brand-cyan)); display: flex; align-items: center; justify-content: center; font-size: 2.25rem; font-weight: 900; color: #fff; flex-shrink: 0; box-shadow: 0 8px 24px rgba(139, 92, 246, 0.3)">
          云
        </div>

        <!-- 品牌基本信息 -->
        <div style="flex: 1; min-width: 16rem">
          <div style="display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; margin-bottom: 0.5rem">
            <span class="badge badge-brand" style="font-size: 0.75rem">🥇 综合实测第一 · 金融级专线</span>
            <span class="badge badge-green" style="font-size: 0.75rem">✓ 24H 零丢包</span>
            <span class="badge badge-cyan" style="font-size: 0.75rem">✓ 全节点 1 倍率</span>
          </div>
          <h1 style="font-size: 2.25rem; font-weight: 900; color: var(--text-main); line-height: 1.2">云图机场 (Yuntu Airport)</h1>
          <p style="margin-top: 0.5rem; color: var(--text-muted); font-size: 1rem">{brand.tagline}</p>

          <!-- 综合评分 -->
          <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1rem">
            <div style="display: flex; align-items: baseline; gap: 0.25rem">
              <span style="font-size: 3rem; font-weight: 900; color: var(--brand-primary); line-height: 1">{brand.score.toFixed(1)}</span>
              <span style="color: var(--text-sub); font-size: 0.9rem"> /10</span>
            </div>
            <div>
              <p style="font-size: 0.75rem; color: var(--text-muted)">综合实测得分</p>
              <div style="display: flex; gap: 0.125rem; margin-top: 0.25rem">
                {Array.from({length:5}).map((_,i) => (
                  <span style={`color:${i < Math.round(brand.score/2) ? '#f59e0b' : 'var(--border-color)'}; font-size: 1.125rem`}>★</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 注册直达按钮 -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem; min-width: 12rem">
          <a href={brand.url} target="_blank" rel="noopener" id="yuntu-top-cta" class="btn btn-primary" style="padding: 0.875rem 1.75rem; font-size: 1rem; text-align: center">
            🚀 直达云图官网注册
          </a>
          <a href="/compare/" id="yuntu-compare-link" class="btn btn-secondary" style="padding: 0.75rem; font-size: 0.875rem; text-align: center">
            与瞬云横向对比
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 测评核心正文区 ═══ -->
  <section class="section container-site">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 2rem; align-items: start">
      
      <!-- 左侧长文干货 -->
      <div style="grid-column: span 2">
        
        <!-- 一、前言与核心结论 -->
        <div class="card" style="padding: 2rem; margin-bottom: 2rem; background: var(--bg-card)">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            📌 一、编辑部实测结论：为什么云图能拿榜首？
          </h2>
          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem">
            在纷繁复杂的代理市场中，**云图机场** 属于老老实实凭硬核线路口碑立足的老牌服务商。编辑团队自费购买其正式套餐，在电信、联通、移动三网环境下进行了连续 30 天的丢包与速度追踪。
          </p>
          <div style="margin-top: 1.25rem; padding: 1.25rem; background: var(--bg-secondary); border-radius: var(--radius-md); border-left: 4px solid var(--brand-primary)">
            <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-main)">💡 3 句话总结云图机场的核心竞争优势：</h3>
            <ul style="margin-top: 0.5rem; padding-left: 1.25rem; color: var(--text-muted); font-size: 0.9375rem; line-height: 1.8">
              <li><strong>全节点内网物理专线</strong>：拒绝廉价公网直连，在晚高峰（20:00 - 23:00）依然保持 0 丢包、跑满 300Mbps+ 带宽。</li>
              <li><strong>全节点 1 倍率扣费</strong>：绝无部分机场设置 5x 或 10x 扣费的陷阱，用多少扣多少，诚实透明。</li>
              <li><strong>原生 IP 全解锁</strong>：完美解锁 OpenAI (ChatGPT-4o / O1)、Claude AI、Netflix 4K 与 Disney+，绝无 Location Not Supported 弹窗。</li>
            </ul>
          </div>
        </div>

        <!-- 二、线路架构与物理传输剖析 -->
        <div class="card" style="padding: 2rem; margin-bottom: 2rem; background: var(--bg-card)">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            🌐 二、线路架构：金融级 IEPL/IPLC 物理专线
          </h2>
          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem">
            云图机场全站节点均采用高端 **IEPL/IPLC 内网专线**。与市面上普通的中转或公网直连机场相比，物理专线在过境时流量直接走运营商内网私有管道：
          </p>

          <div style="margin-top: 1rem; padding: 1rem; background: var(--bg-secondary); border-radius: var(--radius-md); font-family: monospace; font-size: 0.875rem; color: var(--brand-cyan)">
            用户设备 ──> 国内专线入口 ──> 运营商内网私有通道 (物理不过墙) ──> 境外原生出口 ──> ChatGPT/Netflix
          </div>

          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem; margin-top: 1rem">
            这种架构最大的优势就是：**无论公网多么拥堵，或者遇上敏感封锁时期，专线内部带宽依然畅通无阻，延迟平整呈一条直线**。
          </p>
        </div>

        <!-- 三、套餐详情与扣费明细 -->
        <div class="card" style="padding: 2rem; margin-bottom: 2rem; background: var(--bg-card)">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            💰 三、云图机场套餐价格与性价比表
          </h2>
          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem; margin-bottom: 1.5rem">
            云图机场提供灵活动态的付款周期（支持月付、季付、年付至三年付），所有套餐均享受同时在线 5 台设备与全节点 1 倍率：
          </p>

          <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr))">
            {plans.map(p => (
              <div style="padding: 1.5rem; background: var(--bg-secondary); border-radius: var(--radius-md); border: 1px solid var(--border-color); display: flex; flex-direction: column">
                <div style="display: flex; justify-content: space-between; align-items: center">
                  <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--text-main)">{p.name}</h3>
                  <span class="badge badge-brand">{p.name.includes('限时') ? `¥${p.price} / 一次性` : `¥${p.price} / 月`}</span>
                </div>
                <div style="margin-top: 1rem; font-size: 1.5rem; font-weight: 900; color: var(--brand-primary)">
                  {p.traffic.includes('不限时') ? p.traffic : `${p.traffic} / 月流量`}
                </div>
                <p style="font-size: 0.8125rem; color: var(--brand-cyan); margin-top: 0.25rem; font-weight: 700">
                  {p.highlight}
                </p>
                <ul style="margin-top: 1rem; padding-left: 1rem; font-size: 0.8125rem; color: var(--text-muted); line-height: 1.8; flex: 1">
                  {p.features.map(f => (
                    <li>✓ {f}</li>
                  ))}
                </ul>
                <a href={brand.url} target="_blank" rel="noopener" class="btn btn-primary" style="margin-top: 1.25rem; text-align: center; padding: 0.5rem; font-size: 0.875rem">
                  订阅 {p.name} 套餐 →
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- 四、解锁能力与常见排障 -->
        <div class="card" style="padding: 2rem; background: var(--bg-card)">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            🎬 四、流媒体与 AI 解锁测试矩阵
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.875rem; margin-top: 1.25rem">
            {unlockItems.map(item => (
              <div style="padding: 0.875rem; background: var(--bg-secondary); border-radius: var(--radius-sm); display: flex; align-items: center; gap: 0.5rem">
                <span style="font-size: 1.25rem">{item.icon}</span>
                <div>
                  <div style="font-size: 0.875rem; font-weight: 700; color: var(--text-main)">{item.name}</div>
                  <div style="font-size: 0.75rem; color: var(--brand-green); font-weight: 700">✓ 原生 IP 解锁</div>
                </div>
              </div>
            ))}
          </div>

          <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color)">
            <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--text-main)">💡 配合软件导入食用更佳：</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.7">
              购买云图订阅后，推荐参考本站提供的 <a href="/blog/clash-jiaocheng-2026/" style="color: var(--brand-primary); font-weight: 700; text-decoration: none">Clash 完全配置指南</a> 或 <a href="/blog/shadowrocket-jiaocheng/" style="color: var(--brand-cyan); font-weight: 700; text-decoration: none">iOS 小火箭指南</a> 进行一键导入。
            </p>
          </div>
        </div>

      </div>

      <!-- 右侧侧边栏得分与购买悬浮盒 -->
      <div>
        <div class="card" style="padding: 1.5rem; background: var(--bg-card); position: sticky; top: 5.5rem">
          <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem">
            📊 12 项维度综合实测拆解
          </h3>

          <div style="display: flex; flex-direction: column; gap: 0.875rem">
            {scoreItems.map(s => (
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.25rem">
                  <span style="color: var(--text-muted); font-weight: 600">{s.label}</span>
                  <span style="color: var(--brand-primary); font-weight: 800">{s.score} / 10</span>
                </div>
                <div style="height: 0.5rem; background: var(--bg-secondary); border-radius: 9999px; overflow: hidden">
                  <div style={`width: ${s.score * 10}%; height: 100%; background: linear-gradient(90deg, var(--brand-primary), var(--brand-cyan)); border-radius: 9999px`}></div>
                </div>
              </div>
            ))}
          </div>

          <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); text-align: center">
            <span style="font-size: 0.75rem; color: var(--text-sub); display: block; margin-bottom: 0.75rem">官方安全通道 · 支持支付宝与微信</span>
            <a href={brand.url} target="_blank" rel="noopener" class="btn btn-primary" style="display: block; width: 100%; text-align: center; padding: 0.75rem; font-size: 0.9375rem">
              🚀 立即注册云图机场
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
