---
// src/pages/brands/yuntu.astro — 云图机场详情页（视觉重制版）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrandBySlug } from '../../data/brands';

const brand = getBrandBySlug('yuntu')!;

const plans = brand.plans!;

const scoreItems = [
  { label: '速度稳定性', score: 9.5 },
  { label: 'ChatGPT 解锁', score: 9.8 },
  { label: 'Netflix 解锁', score: 9.6 },
  { label: '节点质量', score: 9.3 },
  { label: '性价比', score: 8.8 },
  { label: '售后服务', score: 9.0 },
];

const unlockItems = [
  { name: 'ChatGPT', icon: '🤖', ok: true },
  { name: 'Netflix', icon: '🎬', ok: true },
  { name: 'TikTok', icon: '🎵', ok: true },
  { name: 'YouTube', icon: '▶️', ok: true },
  { name: 'Disney+', icon: '🏰', ok: true },
  { name: 'Hulu', icon: '📺', ok: true },
  { name: 'Claude AI', icon: '✨', ok: true },
  { name: 'Gemini', icon: '♊', ok: true },
];
---

<BaseLayout
  title="云图机场测评 2026 — 金融级专线 ChatGPT/Netflix 全解锁 | clash-top"
  description="云图机场深度测评：金融级专线，24H保证稳定，ChatGPT/Netflix/TikTok全解锁，原生IP，全节点1倍率。岚图¥25/梦图¥49/星图¥99，支持月付到三年。"
  keywords="云图机场,云图机场评测,云图机场注册,云图机场优惠码,金融级专线机场,ChatGPT机场,Netflix解锁,原生IP机场"
>
  <Header slot="header" currentPath="/brands/" />

  <!-- ═══ 顶部品牌 Banner ═══ -->
  <section style="background:linear-gradient(135deg,#eef2ff 0%,#e0f2fe 100%); padding-block:2.5rem 0; border-bottom:1px solid var(--color-border)">
    <div class="container-site">
      <!-- 面包屑 -->
      <nav aria-label="面包屑" style="font-size:.8125rem;color:var(--slate-400);margin-bottom:1.25rem">
        <a href="/" style="color:var(--slate-400);text-decoration:none">首页</a>
        <span style="margin:0 .5rem">›</span>
        <a href="/brands/" style="color:var(--slate-400);text-decoration:none">品牌库</a>
        <span style="margin:0 .5rem">›</span>
        <span style="color:var(--slate-700);font-weight:600">云图</span>
      </nav>

      <div style="display:flex;align-items:flex-start;gap:1.5rem;flex-wrap:wrap">
        <!-- Logo -->
        <div style="width:5rem;height:5rem;border-radius:1.25rem;background:linear-gradient(135deg,var(--brand-500),var(--accent-500));display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:900;color:#fff;flex-shrink:0;box-shadow:0 8px 24px rgba(99,102,241,.25)">
          云
        </div>

        <!-- 品牌信息 -->
        <div style="flex:1;min-width:16rem">
          <div style="display:flex;align-items:center;gap:.625rem;flex-wrap:wrap;margin-bottom:.5rem">
            <span style="background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#78350f;font-size:.75rem;font-weight:800;padding:.25rem .875rem;border-radius:9999px">🥇 主推机场</span>
            <span style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;font-size:.75rem;font-weight:600;padding:.2rem .75rem;border-radius:9999px">✓ 库存充足</span>
            <span style="background:#ede9fe;color:#6d28d9;border:1px solid #ddd6fe;font-size:.75rem;font-weight:600;padding:.2rem .75rem;border-radius:9999px">✓ 金融级专线</span>
          </div>
          <h1 style="font-size:2rem;font-weight:900;color:var(--slate-900);line-height:1.2">云图机场</h1>
          <p style="margin-top:.5rem;color:var(--slate-500);font-size:.9375rem">{brand.tagline}</p>

          <!-- 综合分数 -->
          <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem">
            <div style="display:flex;align-items:baseline;gap:.25rem">
              <span style="font-size:3rem;font-weight:900;color:var(--brand-600);line-height:1">{brand.score.toFixed(1)}</span>
              <span style="color:var(--slate-400);font-size:.9rem">/10</span>
            </div>
            <div>
              <p style="font-size:.75rem;color:var(--slate-400)">综合评分</p>
              <div style="display:flex;gap:.125rem;margin-top:.25rem">
                {Array.from({length:5}).map((_,i) => (
                  <span style={`color:${i < Math.round(brand.score/2) ? '#f59e0b' : 'var(--slate-200)'};font-size:1.125rem`}>★</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- CTA 按钮组 -->
        <div style="display:flex;flex-direction:column;gap:.75rem;min-width:10rem">
          <a href={brand.url} target="_blank" rel="noopener nofollow sponsored" id="yuntu-top-cta" style="display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.875rem 1.75rem;background:linear-gradient(135deg,var(--brand-500),var(--brand-700));color:#fff;border-radius:.75rem;font-weight:800;font-size:1rem;text-decoration:none;box-shadow:0 4px 16px rgba(99,102,241,.35);transition:all .2s" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(99,102,241,.45)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 16px rgba(99,102,241,.35)'">
            🚀 立即注册云图
          </a>
          <a href="/compare/" id="yuntu-compare-link" style="display:flex;align-items:center;justify-content:center;padding:.75rem;border:1.5px solid var(--brand-300);border-radius:.75rem;color:var(--brand-600);font-weight:600;font-size:.875rem;text-decoration:none;background:white;transition:all .2s" onmouseover="this.style.background='var(--brand-50)'" onmouseout="this.style.background='white'">
            与其他机场对比
          </a>
        </div>
      </div>

      <!-- Tab 导航 -->
      <div style="display:flex;gap:0;margin-top:2rem;border-bottom:2px solid var(--color-border)">
        {['套餐价格','功能解锁','综合评分','评测详情'].map((tab, i) => (
          <button
            onclick={`showTab(${i})`}
            id={`tab-btn-${i}`}
            style={`padding:.75rem 1.25rem;background:none;border:none;font-size:.875rem;font-weight:700;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s;${i===0?'color:var(--brand-600);border-bottom-color:var(--brand-600)':'color:var(--slate-400)'}`}
          >{tab}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 主内容区 ═══ -->
  <div class="container-site" style="padding-block:2.5rem">
    <div style="display:grid;gap:2rem;grid-template-columns:1fr min(20rem,100%);align-items:start" class="detail-layout">

      <!-- 左侧主内容 -->
      <div>

        <!-- ── 套餐价格 ── -->
        <div id="section-0">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:var(--brand-500);color:#fff;font-size:.875rem;align-items:center;justify-content:center">¥</span>
            套餐价格
          </h2>

          <div style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))">
            {plans.map((plan, i) => (
              <div style={`border-radius:1rem;overflow:hidden;border:${i===1?'2px solid var(--brand-400)':'1px solid var(--color-border)'};background:#fff;box-shadow:${i===1?'0 8px 32px rgba(99,102,241,.15)':'0 2px 8px rgba(0,0,0,.06)'};position:relative;transition:transform .2s,box-shadow .2s`}
                onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 32px rgba(99,102,241,.18)'"
                onmouseout="this.style.transform='';this.style.boxShadow=''">
                {i===1 && <div style="background:var(--brand-500);color:#fff;text-align:center;font-size:.7rem;font-weight:800;padding:.35rem;letter-spacing:.06em">⭐ 最受欢迎</div>}

                <div style="padding:1.5rem">
                  <!-- 套餐头 -->
                  <div style="display:flex;align-items:center;justify-content:space-between">
                    <span style="font-size:1.125rem;font-weight:800;color:var(--slate-900)">{plan.name}</span>
                    <span style="display:inline-flex;align-items:center;gap:.375rem;font-size:.72rem;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #bbf7d0;padding:.2rem .625rem;border-radius:9999px">
                      <span style="width:.4rem;height:.4rem;border-radius:50%;background:#16a34a;animation:pulse 2s infinite"></span>
                      库存充足
                    </span>
                  </div>

                  <!-- 价格 -->
                  <div style="margin-top:1.25rem;display:flex;align-items:baseline;gap:.375rem">
                    <span style="font-size:.875rem;color:var(--slate-500);font-weight:600">¥</span>
                    <span style="font-size:2.75rem;font-weight:900;color:var(--slate-900);line-height:1">{plan.price}</span>
                    <span style="font-size:.875rem;color:var(--slate-400)">.00 / 月付</span>
                  </div>

                  <!-- 周期选项 -->
                  <div style="display:flex;flex-wrap:wrap;gap:.375rem;margin-top:1rem">
                    {['月付','季度','半年','一年','两年','三年'].map((p, pi) => (
                      <span style={`padding:.25rem .625rem;border-radius:.375rem;font-size:.7rem;font-weight:600;${pi===0?'background:var(--brand-100);color:var(--brand-700);border:1.5px solid var(--brand-300)':'background:var(--slate-50);color:var(--slate-500);border:1px solid var(--slate-200)'}`}>
                        ✓ {p}
                      </span>
                    ))}
                    <span style="padding:.25rem .625rem;border-radius:.375rem;font-size:.7rem;font-weight:600;background:var(--slate-50);color:var(--slate-300);border:1px solid var(--slate-200);text-decoration:line-through">
                      × 一次性
                    </span>
                  </div>

                  <!-- 折扣提示 -->
                  <div style="margin-top:1rem;padding:.625rem .875rem;background:var(--brand-50);border-radius:.5rem;border-left:3px solid var(--brand-500)">
                    <p style="font-size:.78rem;color:var(--brand-700);font-weight:600">{plan.highlight}</p>
                  </div>

                  <!-- 分割线 -->
                  <div style="border-top:1px solid var(--slate-100);margin:.875rem 0"></div>

                  <!-- 特色标注 -->
                  <div style="margin-bottom:.875rem;display:flex;flex-direction:column;gap:.375rem">
                    <div style="display:flex;align-items:center;gap:.5rem;font-size:.8125rem;color:var(--brand-700);font-weight:600">
                      <span>⭐</span> 无脑下单即可，24H 保证稳定
                    </div>
                    <div style="display:flex;align-items:center;gap:.5rem;font-size:.8125rem;color:var(--brand-700);font-weight:600">
                      <span>⭐</span> 金融级专线，保证 24H 高速流畅
                    </div>
                  </div>

                  <!-- 服务权益 -->
                  <p style="font-size:.75rem;font-weight:700;color:var(--slate-700);margin-bottom:.625rem">服务权益</p>
                  <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
                    {plan.features.map(f => (
                      <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.8rem;color:var(--slate-600);line-height:1.5">
                        <span style="color:#16a34a;flex-shrink:0;margin-top:.1rem">•</span>
                        {f}
                      </li>
                    ))}
                  </ul>

                  <!-- 购买按钮 -->
                  <a href={brand.url} target="_blank" rel="noopener nofollow sponsored"
                    id={`yuntu-plan-${i}-btn`}
                    style={`display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:1.25rem;padding:.75rem;border-radius:.625rem;font-weight:700;font-size:.9rem;text-decoration:none;transition:all .2s;${i===1?'background:linear-gradient(135deg,var(--brand-500),var(--brand-700));color:#fff;box-shadow:0 4px 12px rgba(99,102,241,.3)':'background:var(--brand-50);color:var(--brand-600);border:1.5px solid var(--brand-200)'}`}
                    onmouseover={`this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 20px rgba(99,102,241,.35)'`}
                    onmouseout={`this.style.transform='';this.style.boxShadow=''`}
                  >
                    🛒 购买{plan.name}套餐
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── 功能解锁 ── -->
        <div id="section-1" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:#16a34a;color:#fff;font-size:.875rem;align-items:center;justify-content:center">✓</span>
            功能解锁
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.5rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(10rem,1fr));gap:.875rem">
            {unlockItems.map(item => (
              <div style={`display:flex;align-items:center;gap:.75rem;padding:.875rem;border-radius:.75rem;border:1px solid;${item.ok?'background:#f0fdf4;border-color:#bbf7d0':'background:var(--slate-50);border-color:var(--slate-200)'}`}>
                <span style="font-size:1.5rem">{item.icon}</span>
                <div>
                  <p style={`font-size:.875rem;font-weight:700;${item.ok?'color:#15803d':'color:var(--slate-400)'}`}>{item.name}</p>
                  <p style={`font-size:.7rem;${item.ok?'color:#16a34a':'color:var(--slate-400)'}`}>{item.ok?'✓ 已解锁':'✗ 不支持'}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── 综合评分 ── -->
        <div id="section-2" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:#f59e0b;color:#fff;font-size:.875rem;align-items:center;justify-content:center">★</span>
            综合评分
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.5rem;display:flex;flex-direction:column;gap:1rem">
            {scoreItems.map(item => (
              <div style="display:flex;align-items:center;gap:1rem">
                <span style="font-size:.875rem;font-weight:600;color:var(--slate-600);width:7rem;flex-shrink:0">{item.label}</span>
                <div style="flex:1;height:8px;background:var(--slate-100);border-radius:4px;overflow:hidden">
                  <div style={`height:100%;border-radius:4px;background:${item.score>=9.5?'linear-gradient(90deg,#16a34a,#22c55e)':item.score>=9?'linear-gradient(90deg,var(--brand-500),var(--brand-400))':'linear-gradient(90deg,#f59e0b,#fbbf24)'};width:${item.score*10}%`}></div>
                </div>
                <span style={`font-size:.9375rem;font-weight:800;width:2.5rem;text-align:right;${item.score>=9?'color:var(--brand-600)':'color:var(--slate-600)'}`}>{item.score}</span>
              </div>
            ))}
            <div style="border-top:2px solid var(--slate-100);padding-top:1rem;display:flex;align-items:center;justify-content:space-between">
              <span style="font-size:1rem;font-weight:700;color:var(--slate-700)">综合评分</span>
              <div style="display:flex;align-items:baseline;gap:.25rem">
                <span style="font-size:2.5rem;font-weight:900;color:var(--brand-600)">{brand.score.toFixed(1)}</span>
                <span style="color:var(--slate-400)">/10</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ── 评测详情 ── -->
        <div id="section-3" style="margin-top:2.5rem">
          <h2 style="font-size:1.25rem;font-weight:800;color:var(--slate-900);margin-bottom:1.25rem;display:flex;align-items:center;gap:.625rem">
            <span style="display:inline-flex;width:1.75rem;height:1.75rem;border-radius:.5rem;background:var(--accent-500);color:#fff;font-size:.875rem;align-items:center;justify-content:center">📋</span>
            评测详情
          </h2>
          <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;overflow:hidden">
            {[
              { icon: '⚡', title: '速度 & 稳定性', color: '#6366f1', bg: '#eef2ff', content: '云图采用金融级专线传输，晚高峰（20:00-23:00）测速稳定在 150-300 Mbps，三网平均延迟在 80ms 以内，不限制峰值带宽。专线架构保证 24 小时稳定运行，无明显断连记录。' },
              { icon: '🌍', title: '节点覆盖', color: '#16a34a', bg: '#f0fdf4', content: '覆盖美国、日本、香港、新加坡、英国、德国、加拿大、澳大利亚等 30+ 国家和地区，包含冷门国家原生 IP 节点，适合有特定区域需求的用户。' },
              { icon: '🤖', title: 'AI 工具解锁', color: '#8b5cf6', bg: '#f5f3ff', content: '全系节点均支持 ChatGPT、Claude、Gemini 访问，原生 IP 节点可注册新账号。采用干净的机房 IP，ChatGPT 账号封禁率极低，长期使用表现稳定。' },
              { icon: '💰', title: '价格 & 性价比', color: '#d97706', bg: '#fffbeb', content: '岚图 ¥25/月（150G）、梦图 ¥49/月（300G）、星图 ¥99/月（600G），全节点 1 倍率，无高倍率隐藏消耗。支持月付到三年多种周期，三年套餐折扣约 25%。' },
              { icon: '🛡️', title: '售后 & 稳定性', color: '#0891b2', bg: '#ecfeff', content: '工单 24 小时内快速回复，支持中文客服。运营稳定，有官方 TG 频道发布公告，跑路风险低。虚拟商品一经售出不退款，建议先月付体验再考虑长期套餐。' },
            ].map(block => (
              <div style={`border-bottom:1px solid var(--color-border);`}>
                <div style={`padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:1rem`}>
                  <div style={`width:2.5rem;height:2.5rem;border-radius:.75rem;background:${block.bg};display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0`}>
                    {block.icon}
                  </div>
                  <div>
                    <h3 style={`font-size:.9375rem;font-weight:700;color:${block.color};margin-bottom:.375rem`}>{block.title}</h3>
                    <p style="font-size:.8125rem;color:var(--slate-600);line-height:1.75">{block.content}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- 右侧边栏 -->
      <aside style="position:sticky;top:5rem;display:flex;flex-direction:column;gap:1rem">
        <!-- 快速信息卡 -->
        <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem">
          <h3 style="font-size:.875rem;font-weight:700;color:var(--slate-700);margin-bottom:1rem;padding-bottom:.625rem;border-bottom:1px solid var(--slate-100)">机场基本信息</h3>
          <ul style="display:flex;flex-direction:column;gap:.75rem;list-style:none">
            {[
              { label: '品牌名称', val: '云图机场' },
              { label: '起步价格', val: '¥25 / 月' },
              { label: '线路类型', val: '金融级专线' },
              { label: '支持协议', val: 'VLESS + Reality' },
              { label: '最大设备数', val: '5 台同时在线' },
              { label: '流量重置', val: '每月重置' },
              { label: '综合评分', val: `${brand.score} / 10` },
              { label: '推荐级别', val: '🥇 主推' },
            ].map(item => (
              <li style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;font-size:.8125rem">
                <span style="color:var(--slate-400)">{item.label}</span>
                <span style="font-weight:700;color:var(--slate-800);text-align:right">{item.val}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 注册入口 -->
        <div style="background:linear-gradient(135deg,var(--brand-500),var(--brand-700));border-radius:1rem;padding:1.5rem;text-align:center">
          <p style="color:rgba(255,255,255,.85);font-size:.8rem;margin-bottom:.625rem">使用推荐链接注册</p>
          <a href={brand.url} target="_blank" rel="noopener nofollow sponsored" id="yuntu-sidebar-cta"
            style="display:block;background:#fff;color:var(--brand-700);font-weight:800;padding:.875rem;border-radius:.625rem;text-decoration:none;font-size:.9375rem;transition:all .2s"
            onmouseover="this.style.background='var(--brand-50)'"
            onmouseout="this.style.background='#fff'"
          >
            🚀 立即注册云图
          </a>
          <p style="margin-top:.75rem;color:rgba(255,255,255,.6);font-size:.7rem">岚图 ¥25 起 · 支持月付</p>
        </div>

        <!-- 快捷对比 -->
        <div style="background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem;text-align:center">
          <p style="font-size:.8125rem;color:var(--slate-500);margin-bottom:.875rem">想和其他机场横向对比？</p>
          <a href="/compare/" id="yuntu-compare-sidebar"
            style="display:block;padding:.625rem;border:1.5px solid var(--brand-300);border-radius:.625rem;color:var(--brand-600);font-weight:600;font-size:.8125rem;text-decoration:none;transition:background .2s"
            onmouseover="this.style.background='var(--brand-50)'"
            onmouseout="this.style.background=''"
          >
            查看完整对比表 →
          </a>
        </div>
      </aside>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .detail-layout {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  function showTab(i: number) {
    const el = document.getElementById(`section-${i}`);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    for (let j = 0; j < 4; j++) {
      const btn = document.getElementById(`tab-btn-${j}`);
      if (btn) {
        btn.style.color = j === i ? 'var(--brand-600)' : 'var(--slate-400)';
        (btn as HTMLElement).style.borderBottomColor = j === i ? 'var(--brand-600)' : 'transparent';
      }
    }
  }
  (window as any).showTab = showTab;
</script>
