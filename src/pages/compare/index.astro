---
// src/pages/compare/index.astro — 横向对比 (云图与瞬云实测全维度大表)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { brands } from '../../data/brands';

function checkIcon(v: boolean) {
  return v
    ? '<span style="color:var(--brand-green);font-weight:700;font-size:1.1rem">✓ 支持</span>'
    : '<span style="color:var(--text-sub);font-size:0.875rem">—</span>';
}

const dimensions = [
  { key: 'score', label: '综合评分' },
  { key: 'priceFrom', label: '起步价' },
  { key: 'protocol', label: '主要协议' },
  { key: 'nodeCount', label: '节点覆盖' },
  { key: 'streamUnlock', label: '流媒体解锁' },
  { key: 'aiUnlock', label: 'ChatGPT 解锁' },
  { key: 'rankLabel', label: '推荐级别' },
];
---

<BaseLayout
  title="机场横向对比 2026 — 云图专线与瞬云 ANYCAST 维度比较 | clash-top"
  description="统一维度横向对比实测机场：价格、节点数、协议类型、流媒体解锁、ChatGPT/Claude AI 支持，一张表看清所有差异，快速做出选购决策。"
>
  <Header slot="header" currentPath="/compare/" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container-site">
      <span class="badge badge-brand" style="margin-bottom: 1rem">全维度实测数据对齐</span>
      <h1 class="page-hero-title">横向对比大表</h1>
      <p class="page-hero-desc">价格、协议、节点数、流媒体与 ChatGPT 原生 IP 支持度，统一维度放进同张表，关键差异一眼看懂。</p>
    </div>
  </section>

  <!-- Main Compare Table -->
  <section class="section container-site" aria-label="机场对比表">
    <div class="card" style="padding: 1.75rem; background: var(--bg-card); border: 1px solid var(--border-color)">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem">
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main)">实测机场对比（精选 {brands.length} 家）</h2>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem">编辑团队真实自费测试，数据每周定期核实</p>
        </div>
        <span class="badge badge-cyan">
          <span class="pulse-dot" style="color: var(--brand-cyan)" aria-hidden="true"></span>
          数据已核实
        </span>
      </div>

      <div style="overflow-x: auto">
        <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color)">
              <th style="padding: 0.875rem 1rem">排名</th>
              <th style="padding: 0.875rem 1rem">机场名称</th>
              {dimensions.map(d => <th style="padding: 0.875rem 1rem">{d.label}</th>)}
              <th style="padding: 0.875rem 1rem; text-align: right">注册直达</th>
            </tr>
          </thead>
          <tbody>
            {brands.map(b => (
              <tr style="border-bottom: 1px solid var(--border-color)">
                <td style="padding: 1rem">
                  <span class="badge badge-brand" style="font-weight: 900">#{b.rank}</span>
                </td>
                <td style="padding: 1rem">
                  <div style="display: flex; flex-direction: column">
                    <span style="font-weight: 800; color: var(--text-main); font-size: 1.0625rem">{b.name}</span>
                    <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem">{b.tagline}</span>
                  </div>
                </td>
                <td style="padding: 1rem">
                  <span style="font-weight: 900; color: var(--brand-primary); font-size: 1.125rem">{b.score.toFixed(1)}</span>
                  <span style="color: var(--text-sub); font-size: 0.75rem"> /10</span>
                </td>
                <td style="padding: 1rem; font-weight: 700; color: var(--text-main); white-space: nowrap">{b.priceFrom}</td>
                <td style="padding: 1rem"><span class="badge badge-cyan">{b.protocol}</span></td>
                <td style="padding: 1rem; font-weight: 600">{b.nodeCount}</td>
                <td style="padding: 1rem" set:html={checkIcon(b.streamUnlock)} />
                <td style="padding: 1rem" set:html={checkIcon(b.aiUnlock)} />
                <td style="padding: 1rem">
                  <span class="badge badge-brand">{b.rankLabel}</span>
                </td>
                <td style="padding: 1rem; text-align: right">
                  <a href={b.url} target="_blank" rel="noopener" class="btn btn-primary" style="padding: 0.35rem 0.875rem; font-size: 0.8125rem">
                    官网注册 →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 选购建议 -->
  <section style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); padding-block: 3.5rem">
    <div class="container-site">
      <div style="margin-bottom: 2rem; text-align: center">
        <h2 class="section-title">按场景选机场，直接说结论</h2>
        <p class="section-desc">根据你的核心用途选择最匹配的服务商：</p>
      </div>

      <div style="display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr))">
        {[
          { icon: '⚡', title: '重度办公 / AI / 极度看重稳定', desc: '选云图机场。全节点内网 IEPL 专线，晚高峰丢包率 0%，原生 IP 解锁 ChatGPT 与 Claude，工单 24 小时响应。', brand: '云图机场 (主推)', link: '/brands/yuntu/' },
          { icon: '🎬', title: '大流量追剧 / 高清视频 / 性价比', desc: '选瞬云机场。ANYCAST 高速节点，不限速，流量每月自动重置，YouTube 4K 秒加载，月付仅需 ¥20。', brand: '瞬云机场 (次推)', link: '/brands/shunyun/' },
        ].map(card => (
          <div class="card card-hover" style="padding: 1.75rem; background: var(--bg-card)">
            <span style="font-size: 2.25rem" aria-hidden="true">{card.icon}</span>
            <h3 style="margin-top: 0.75rem; font-size: 1.125rem; font-weight: 800; color: var(--text-main)">{card.title}</h3>
            <p style="margin-top: 0.5rem; font-size: 0.875rem; line-height: 1.7; color: var(--text-muted)">{card.desc}</p>
            <div style="margin-top: 1.25rem; display: flex; justify-content: space-between; align-items: center">
              <span class="badge badge-brand">{card.brand}</span>
              <a href={card.link} style="font-size: 0.8125rem; font-weight: 700; color: var(--brand-primary); text-decoration: none">查看测评详情 →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
