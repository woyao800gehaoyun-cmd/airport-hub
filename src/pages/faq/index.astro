---
// src/pages/faq/index.astro — 长尾问题库 (含实时搜索 + 精美高对比度极客排版)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { faqs, faqCategories } from '../../data/faqs';
---

<BaseLayout
  title="机场问题库 2026 — 180+ 高频问题与连接排障全解答 | clash-top"
  description="clash-top 机场长尾问题库：收录「机场是什么」「TUN模式开启」「IPLC与IEPL区别」「ChatGPT解锁」「晚高峰超时排障」等高频问题的超详细图文解答。"
  keywords="机场问题库,机场FAQ,Clash排障,超时排障,IPLC专线原理,ChatGPT解锁,Netflix解锁,机场跑路预警"
>
  <Header slot="header" currentPath="/faq/" />

  <!-- Page Hero 顶部搜索与分类 -->
  <section class="page-hero">
    <div class="container-site" style="max-width: 52rem">
      <span class="badge badge-brand" style="margin-bottom: 1rem">一站式疑难排障</span>
      <h1 class="page-hero-title">机场长尾问题库</h1>
      <p class="page-hero-desc">整理了 180+ 个关于机场选购、分流配置、全平台客户端使用与超时排障的实操干货。</p>

      <!-- 实时搜索框 (核心交互升级) -->
      <div style="margin-top: 2rem; position: relative">
        <input
          type="text"
          id="faq-search-input"
          placeholder="🔍 输入问题关键词排障（例如：超时 / TUN / ChatGPT / 专线 / 跑路 / 小火箭）..."
          style="width: 100%; padding: 0.875rem 1.25rem 0.875rem 3rem; border-radius: 9999px; border: 1.5px solid var(--border-color); background: var(--bg-card); color: var(--text-main); font-size: 0.9375rem; outline: none; transition: all 0.2s ease"
        />
        <span style="position: absolute; left: 1.125rem; top: 50%; transform: translateY(-50%); font-size: 1.125rem; color: var(--text-muted)">🔍</span>
      </div>

      <!-- 分类 Tab Pill -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.5rem" id="faq-filters" role="tablist">
        {faqCategories.map((cat, i) => (
          <button
            class={`faq-filter-btn${i === 0 ? ' active' : ''}`}
            data-category={cat === '全部' ? 'all' : cat}
            id={`faq-cat-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Accordion 主区域 -->
  <section class="section container-site" aria-label="常见问题列表">
    <div style="max-width: 52rem; margin: 0 auto">
      
      <div class="card" style="padding: 0.5rem 1.5rem" id="faq-list">
        {faqs.map((faq, i) => (
          <div class="accordion-item" id={`faq-page-item-${i}`} data-category={faq.category} data-question={faq.question} data-answer={faq.answer}>
            <button
              class="accordion-trigger"
              id={`faq-page-trigger-${i}`}
              aria-controls={`faq-page-content-${i}`}
              aria-expanded="false"
              type="button"
            >
              <span style="display: flex; align-items: center; gap: 0.75rem; text-align: left; flex: 1">
                <span class="badge badge-brand" style="flex-shrink: 0; font-size: 0.75rem">{faq.category}</span>
                <span style="font-size: 1rem; font-weight: 700; color: var(--text-main)">{faq.question}</span>
              </span>
              <!-- CSS 严格限制 1.25rem 尺寸的缩放箭头 -->
              <svg class="accordion-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <div
              class="accordion-content"
              id={`faq-page-content-${i}`}
              role="region"
              aria-labelledby={`faq-page-trigger-${i}`}
            >
              <p style="color: var(--text-muted); line-height: 1.8; font-size: 0.9375rem">
                {faq.answer}
              </p>

              {faq.solutionSteps && faq.solutionSteps.length > 0 && (
                <div style="margin-top: 1rem; padding: 1rem; background: var(--bg-secondary); border-radius: var(--radius-md); border-left: 3px solid var(--brand-primary)">
                  <h4 style="font-size: 0.875rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem">💡 实操排障建议 / 核心解法：</h4>
                  <ul style="padding-left: 1.25rem; font-size: 0.8125rem; color: var(--text-muted); line-height: 1.8">
                    {faq.solutionSteps.map(step => (
                      <li>{step}</li>
                    ))}
                  </ul>
                </div>
              )}

              {faq.recommendLink && (
                <div style="margin-top: 1rem">
                  <a href={faq.recommendLink.url} class="btn btn-secondary" style="font-size: 0.8125rem; padding: 0.35rem 0.875rem; display: inline-flex">
                    {faq.recommendLink.text}
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- 空搜索结果状态 -->
      <div id="faq-empty" style="display: none; text-align: center; padding: 4rem 2rem; color: var(--text-muted)">
        <div style="font-size: 3rem" aria-hidden="true">💡</div>
        <p style="margin-top: 1rem; font-size: 1.125rem; font-weight: 700; color: var(--text-main)">未找到匹配的问题</p>
        <p style="margin-top: 0.5rem; font-size: 0.875rem">尝试更换搜索关键词（例如“超时”、“订阅”、“专线”），或到 Telegram 频道提问</p>
      </div>

      <!-- 提问与互动 Banner -->
      <div class="card" style="margin-top: 2rem; padding: 2rem; text-align: center; background: var(--bg-card); border-top: 3px solid var(--brand-primary)">
        <span style="font-size: 2.25rem" aria-hidden="true">📢</span>
        <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-top: 0.5rem">没找到你想问的具体疑难杂症？</h3>
        <p style="margin-top: 0.5rem; font-size: 0.875rem; color: var(--text-muted); max-width: 32rem; margin-inline: auto; line-height: 1.7">
          加入 Telegram 官方频道直接向编辑团队反馈，我们会定期整理常见问题并补充进问题库。
        </p>
        <a href="https://t.me/rumors6688" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top: 1.25rem; display: inline-flex; padding: 0.65rem 1.5rem; font-size: 0.875rem" id="faq-tg-ask-btn">
          📢 去 Telegram 频道提问 (@rumors6688)
        </a>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // 手风琴逻辑
  document.querySelectorAll('#faq-list .accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.accordion-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('#faq-list .accordion-item.open').forEach(openItem => {
        if (openItem !== item) {
          openItem.classList.remove('open');
          openItem.querySelector('.accordion-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      if (item) {
        item.classList.toggle('open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      }
    });
  });

  // 分类筛选与搜索逻辑
  const tabs = document.querySelectorAll('#faq-filters .faq-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('#faq-list .accordion-item');
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const empty = document.getElementById('faq-empty');

  let currentCategory = 'all';

  function filterFaqs() {
    const query = searchInput?.value.toLowerCase().trim() ?? '';
    let visibleCount = 0;

    items.forEach(item => {
      const category = item.dataset.category ?? '';
      const question = (item.dataset.question ?? '').toLowerCase();
      const answer = (item.dataset.answer ?? '').toLowerCase();

      const matchCategory = currentCategory === 'all' || category === currentCategory;
      const matchSearch = query === '' || question.includes(query) || answer.includes(query);

      const show = matchCategory && matchSearch;
      item.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      currentCategory = (tab as HTMLElement).dataset.category ?? 'all';
      filterFaqs();
    });
  });

  searchInput?.addEventListener('input', filterFaqs);
</script>
