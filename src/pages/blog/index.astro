---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, categories } from '../../data/articles';
---

<BaseLayout
  title="博客 — 机场使用教程与测评文章 — Clash顶选"
  description="Clash顶选博客：机场使用教程、深度评测、横向对比、新手入门指南，帮助用户从入门到精通地使用代理服务。"
>
  <Header slot="header" currentPath="/blog/" />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container-site">
      <h1 class="page-hero-title">博客文章</h1>
      <p class="page-hero-desc">机场教程、深度评测、使用技巧，持续更新，内容保持高度时效性。</p>

      <!-- 分类 Tab -->
      <div class="filter-tabs" style="margin-top:1.5rem" id="blog-category-tabs" role="tablist">
        {categories.map((cat, i) => (
          <button
            class={`filter-tab${i === 0 ? ' active' : ''}`}
            data-category={cat.slug}
            id={`cat-tab-${cat.slug}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="section container-site" aria-label="文章列表">
    <div class="articles-grid" id="blog-grid">
      {articles.map(article => (
        <div data-category={article.categorySlug} class="blog-item">
          <ArticleCard {...article} />
        </div>
      ))}
    </div>

    <div id="blog-empty" style="display:none; text-align:center; padding:3rem; color:var(--slate-400)">
      <p style="font-size:2.5rem" aria-hidden="true">📝</p>
      <p style="margin-top:.75rem; font-weight:600">该分类暂无文章，内容持续补充中</p>
    </div>
  </section>

  <!-- 写作说明 -->
  <section style="background:var(--brand-50); border-top:1px solid var(--brand-100); padding-block:2.5rem">
    <div class="container-site" style="max-width:48rem; text-align:center">
      <h2 style="font-size:1.125rem; font-weight:700; color:var(--brand-800)">📌 内容更新说明</h2>
      <p style="margin-top:.75rem; color:var(--slate-600); font-size:.9rem; line-height:1.75">
        本站文章均由编辑团队撰写，不接受付费软文。每篇文章在发布后定期复核，
        确保内容与当前实际情况保持一致。如发现内容有误，欢迎通过 TG 频道反馈。
      </p>
      <a href="/tg/" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:1.25rem; display:inline-flex" id="blog-tg-btn">
        📢 订阅更新推送
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('#blog-category-tabs .filter-tab');
  const items = document.querySelectorAll<HTMLElement>('.blog-item');
  const empty = document.getElementById('blog-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');

      const cat = (tab as HTMLElement).dataset.category ?? 'all';
      let visible = 0;

      items.forEach(item => {
        const show = cat === 'all' || item.dataset.category === cat;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
