---
// src/components/CompareTable.astro — 极客风横向对比表
import { brands } from '../data/brands';

const previewBrands = brands.slice(0, 5);

function checkIcon(v: boolean) {
  return v
    ? '<span style="color:#34d399; font-weight:700">✓ 解锁</span>'
    : '<span style="color:var(--text-sub)">—</span>';
}
---

<section class="section container-site" aria-labelledby="compare-title">
  <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem">
    <div>
      <span class="badge badge-cyan">横向评测</span>
      <h2 class="section-title" id="compare-title" style="margin-top: 0.5rem">头部机场关键参数对比</h2>
      <p class="section-desc">价格、节点架构、流媒体与 AI 解锁能力一表速查。</p>
    </div>
    <a href="/compare/" class="btn btn-secondary">查看完整 10+ 家对比表 →</a>
  </div>

  <div class="card" style="overflow-x: auto">
    <table class="data-table" style="min-width: 40rem">
      <thead>
        <tr>
          <th>机场名称</th>
          <th>实测评分</th>
          <th>起步价</th>
          <th>协议架构</th>
          <th>流媒体解锁</th>
          <th>AI 工具支持</th>
          <th>推荐级别</th>
        </tr>
      </thead>
      <tbody>
        {previewBrands.map(b => (
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem">
                <span class="badge badge-brand">{b.rank}</span>
                <span style="font-weight: 700; color: var(--text-main)">{b.name}</span>
              </div>
            </td>
            <td>
              <span style="font-weight: 800; color: #34d399">{b.score.toFixed(1)}</span>
              <span style="color: var(--text-sub); font-size: 0.75rem"> / 10</span>
            </td>
            <td style="font-weight: 700">{b.priceFrom}</td>
            <td>
              <span class="badge">{b.protocol.split('+')[0].trim()}</span>
            </td>
            <td set:html={checkIcon(b.streamUnlock)} />
            <td set:html={checkIcon(b.aiUnlock)} />
            <td>
              <span class={`badge ${b.rank === 1 ? 'badge-amber' : 'badge-green'}`}>{b.rankLabel}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
