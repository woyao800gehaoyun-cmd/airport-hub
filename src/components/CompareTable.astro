---
// src/components/CompareTable.astro
// 首页对比预览表，显示前 5 家
import { brands } from '../data/brands';

const previewBrands = brands.slice(0, 5);

function checkIcon(v: boolean) {
  return v
    ? '<span style="color:#16a34a; font-weight:700">✓</span>'
    : '<span style="color:#94a3b8">—</span>';
}
---

<section class="section container-site" aria-labelledby="compare-title">
  <div class="section-row-header">
    <div>
      <p class="section-eyebrow">横向对比</p>
      <h2 class="section-title" id="compare-title">关键差异一张表看懂</h2>
      <p class="section-desc">统一维度横向对比，价格、线路、解锁支持一目了然。</p>
    </div>
    <a href="/compare/" class="btn btn-ghost" id="compare-more-btn">完整对比 →</a>
  </div>

  <div class="compare-wrapper">
    <div class="compare-table-head">
      <h3 style="font-size:.9375rem; font-weight:700; color:var(--slate-900)">头部机场速览</h3>
      <p style="font-size:.8125rem; color:var(--slate-500); margin-top:.25rem">完整对比请前往对比页</p>
    </div>
    <div style="overflow-x:auto">
      <table class="data-table" style="min-width:36rem">
        <thead>
          <tr>
            <th>机场名称</th>
            <th>综合评分</th>
            <th>起步价</th>
            <th>线路类型</th>
            <th>流媒体</th>
            <th>AI 解锁</th>
            <th>推荐级别</th>
          </tr>
        </thead>
        <tbody>
          {previewBrands.map(b => (
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:.625rem">
                  <span class={`rank-badge ${b.rank === 1 ? 'rank-1' : b.rank === 2 ? 'rank-2' : b.rank === 3 ? 'rank-3' : 'rank-n'}`}>{b.rank}</span>
                  <span style="font-weight:600; color:var(--slate-900)">{b.name}</span>
                </div>
              </td>
              <td>
                <span style="font-weight:700; color:var(--brand-700)">{b.score.toFixed(1)}</span>
                <span style="color:var(--slate-400); font-size:.75rem">/10</span>
              </td>
              <td style="font-weight:600">{b.priceFrom}</td>
              <td>
                <span class="badge">{b.protocol.split('+')[0].trim()}</span>
              </td>
              <td set:html={checkIcon(b.streamUnlock)} />
              <td set:html={checkIcon(b.aiUnlock)} />
              <td>
                <span class={`badge ${b.rank === 1 ? 'badge-brand' : 'badge-green'}`}>{b.rankLabel}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div style="margin-top:1.25rem; text-align:center">
    <a href="/compare/" class="btn btn-secondary" id="compare-full-btn">
      查看完整 10 家对比表
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>
