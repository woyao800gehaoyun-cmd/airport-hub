---
// src/components/Header.astro — 极客科技风 Header (支持 Dark/Light 切换)
export interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/brands/', label: '品牌库' },
  { href: '/blog/', label: '博客文章' },
  { href: '/topics/', label: '专题目录' },
  { href: '/compare/', label: '横向对比' },
  { href: '/faq/', label: '问题库' },
  { href: '/about/', label: '关于本站' },
];
---

<header class="site-header">
  <div class="container-site header-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="clash-top 科学上网导航首页">
      <div class="logo-icon" aria-hidden="true">C</div>
      <div style="display: flex; flex-direction: column">
        <span class="gradient-text-neon" style="font-weight: 900; font-size: 1.2rem; line-height: 1.1">clash-top</span>
        <span style="font-size: 0.65rem; color: var(--text-sub); font-weight: 600; letter-spacing: 0.05em">科学上网导航</span>
      </div>
    </a>

    <!-- 桌面导航 -->
    <nav class="desktop-nav" aria-label="主导航">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link${currentPath === link.href ? ' active' : ''}`}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- 特殊发光标签组 -->
      <div style="display: flex; gap: 0.375rem; margin-left: 0.5rem">
        <a href="/free-node/" class="badge badge-cyan" style="padding: 0.35rem 0.75rem; text-decoration: none">
          <span>免费节点</span>
          <span class="pulse-dot" style="color: var(--brand-cyan)" aria-hidden="true"></span>
        </a>
        <a href="/airport-status/" class="badge badge-rose" style="padding: 0.35rem 0.75rem; text-decoration: none">
          <span>跑路预警</span>
          <span class="pulse-dot" style="color: var(--brand-rose)" aria-hidden="true"></span>
        </a>
      </div>
    </nav>

    <!-- 右侧操作区：主题切换按钮 + TG 按钮 -->
    <div style="display: flex; align-items: center; gap: 0.625rem">
      <!-- 深浅模式 Toggle 按钮 -->
      <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="切换深色/浅色主题">
        <span id="theme-toggle-icon">🌙</span>
        <span id="theme-toggle-text" style="font-size: 0.75rem">深色</span>
      </button>

      <a
        href="/tg/"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
        id="header-tg-btn"
        style="padding: 0.45rem 1rem; font-size: 0.8125rem"
      >
        <span>📢 TG 频道</span>
      </a>

      <!-- 移动端菜单按钮 -->
      <button
        id="mobile-menu-toggle"
        style="background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-main); font-size: 1.25rem; padding: 0.35rem 0.65rem; border-radius: 0.5rem; cursor: pointer; display: none"
        aria-label="切换导航菜单"
      >
        ≡
      </button>
    </div>
  </div>

  <!-- 移动端下拉导航菜单 -->
  <div id="mobile-menu" style="display: none; background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 1rem 1.25rem">
    <nav style="display: flex; flex-direction: column; gap: 0.5rem">
      {navLinks.map(link => (
        <a href={link.href} class={`nav-link${currentPath === link.href ? ' active' : ''}`}>
          {link.label}
        </a>
      ))}
      <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem">
        <a href="/free-node/" class="badge badge-cyan" style="flex: 1; justify-content: center; padding: 0.5rem">
          免费节点 📡
        </a>
        <a href="/airport-status/" class="badge badge-rose" style="flex: 1; justify-content: center; padding: 0.5rem">
          跑路预警 🚨
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 840px) {
    .desktop-nav {
      display: none !important;
    }
    #mobile-menu-toggle {
      display: block !important;
    }
  }
</style>

<script>
  // 主题切换 JS 逻辑
  const toggleBtn = document.getElementById('theme-toggle');
  const toggleIcon = document.getElementById('theme-toggle-icon');
  const toggleText = document.getElementById('theme-toggle-text');

  function getTheme() {
    return localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (toggleIcon && toggleText) {
      if (theme === 'light') {
        toggleIcon.textContent = '☀️';
        toggleText.textContent = '浅色';
      } else {
        toggleIcon.textContent = '🌙';
        toggleText.textContent = '深色';
      }
    }
  }

  // 初始化主题
  const initialTheme = getTheme();
  setTheme(initialTheme);

  toggleBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    setTheme(next);
  });

  // 移动端菜单
  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    if (mobileMenu) {
      const isVisible = mobileMenu.style.display === 'block';
      mobileMenu.style.display = isVisible ? 'none' : 'block';
    }
  });
</script>
