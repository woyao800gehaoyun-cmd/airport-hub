---
// src/components/Header.astro — 极客深色 Header
export interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/brands/', label: '品牌库' },
  { href: '/blog/', label: '博客文章' },
  { href: '/topics/', label: '专题聚合' },
  { href: '/compare/', label: '横向对比' },
  { href: '/faq/', label: '问题库' },
  { href: '/about/', label: '关于本站' },
];
---

<header class="site-header">
  <div class="container-site header-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="clash-top 科学上网导航首页">
      <div class="logo-icon" aria-hidden="true">C</div>
      <span class="gradient-text-neon" style="font-weight: 900; font-size: 1.25rem;">clash-top</span>
    </a>

    <!-- 桌面导航 -->
    <nav class="desktop-nav" aria-label="主导航">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link${currentPath === link.href ? ' active' : ''}`}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- 特殊发光标签组 -->
      <div style="display: flex; gap: 0.375rem; margin-left: 0.5rem">
        <a href="/free-node/" class="badge badge-cyan" style="padding: 0.35rem 0.75rem; text-decoration: none">
          <span>免费节点</span>
          <span class="pulse-dot" style="color: #38bdf8" aria-hidden="true"></span>
        </a>
        <a href="/airport-status/" class="badge badge-rose" style="padding: 0.35rem 0.75rem; text-decoration: none">
          <span>跑路预警</span>
          <span class="pulse-dot" style="color: #fb7185" aria-hidden="true"></span>
        </a>
      </div>
    </nav>

    <!-- 操作区 -->
    <div style="display: flex; align-items: center; gap: 0.75rem">
      <a
        href="/tg/"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
        id="header-tg-btn"
        style="padding: 0.45rem 1rem; font-size: 0.8125rem"
      >
        <span>📢 官方 TG 频道</span>
      </a>

      <!-- 移动端菜单切换按钮 -->
      <button
        id="mobile-menu-toggle"
        style="background: transparent; border: none; color: var(--text-main); font-size: 1.5rem; cursor: pointer; display: none"
        aria-label="切换导航菜单"
      >
        ≡
      </button>
    </div>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    .desktop-nav {
      display: none !important;
    }
    #mobile-menu-toggle {
      display: block !important;
    }
  }
</style>
