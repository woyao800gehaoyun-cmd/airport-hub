---
// src/components/ArticleCard.astro — 极客风文章卡片
export interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  categorySlug: string;
  tags: string[];
  publishDate: string;
  updateDate: string;
  readTime: number;
}

const { slug, title, excerpt, category, categorySlug, tags, publishDate, updateDate, readTime } = Astro.props;

function formatDate(d: string) {
  const date = new Date(d);
  return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
}
---

<article class="card card-hover" style="padding: 1.5rem; display: flex; flex-direction: column; height: 100%" itemscope itemtype="https://schema.org/Article">
  <div style="display: flex; gap: 0.375rem; flex-wrap: wrap; margin-bottom: 0.875rem">
    <a href={`/category/${categorySlug}/`} class="badge badge-brand" style="text-decoration: none">
      {category}
    </a>
    {tags.slice(0, 2).map(tag => (
      <span class="badge">{tag}</span>
    ))}
  </div>

  <h3 style="font-size: 1.0625rem; font-weight: 700; color: var(--text-main); line-height: 1.45" itemprop="headline">
    <a href={`/blog/${slug}/`} style="text-decoration: none; color: inherit" itemprop="url">
      {title}
    </a>
  </h3>

  <p class="line-clamp-2" style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.625rem; flex: 1; line-height: 1.7" itemprop="description">
    {excerpt}
  </p>

  <div style="margin-top: 1.25rem; padding-top: 0.875rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-sub)">
    <span itemprop="datePublished" content={publishDate}>
      {formatDate(publishDate)}
    </span>
    <span>约 {readTime} 分钟阅读</span>
  </div>
</article>
