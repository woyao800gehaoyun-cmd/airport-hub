---
// src/components/FaqAccordion.astro
import { getFeaturedFaqs } from '../data/faqs';

const faqs = getFeaturedFaqs(6);
---

<section class="section container-site" aria-labelledby="faq-title">
  <div class="section-row-header">
    <div>
      <p class="section-eyebrow">问题库</p>
      <h2 class="section-title" id="faq-title">高频问题快速解答</h2>
      <p class="section-desc">整理了新手最常问的问题，持续扩充中。</p>
    </div>
    <a href="/faq/" class="btn btn-ghost" id="faq-more-btn">全部 180+ 题 →</a>
  </div>

  <div class="card" style="margin-top:0; padding:0 2rem">
    {faqs.map((faq, i) => (
      <div class="accordion-item" id={`faq-item-${i}`}>
        <button
          class="accordion-trigger"
          id={`faq-trigger-${i}`}
          aria-controls={`faq-content-${i}`}
          aria-expanded="false"
          type="button"
        >
          <span>{faq.question}</span>
          <svg class="accordion-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div
          class="accordion-content"
          id={`faq-content-${i}`}
          role="region"
          aria-labelledby={`faq-trigger-${i}`}
        >
          <p>{faq.answer}</p>
        </div>
      </div>
    ))}
  </div>

  <div style="margin-top:1.5rem; text-align:center">
    <a href="/faq/" class="btn btn-secondary" id="faq-full-btn">查看全部 180+ 个问题</a>
  </div>
</section>

<script>
  // 手风琴交互
  document.querySelectorAll('.accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.accordion-item');
      const isOpen = item?.classList.contains('open');

      // 可选：关闭其他项（注释掉则允许多开）
      document.querySelectorAll('.accordion-item.open').forEach(openItem => {
        if (openItem !== item) {
          openItem.classList.remove('open');
          openItem.querySelector('.accordion-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });

      if (item) {
        item.classList.toggle('open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      }
    });
  });
</script>
