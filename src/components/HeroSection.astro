---
// src/components/HeroSection.astro — 极客科技风 Hero (支持 Dark/Light 双模式高对比度)
---
<section class="hero-cyber" aria-label="站点介绍">
  <!-- 发光背景球与背景网格 -->
  <div class="cyber-grid-bg" aria-hidden="true"></div>
  <div class="glow-orb orb-1" aria-hidden="true"></div>
  <div class="glow-orb orb-2" aria-hidden="true"></div>

  <div class="container-site style-relative">
    <div class="hero-center-content">
      <!-- 极客 Tag -->
      <div class="hero-pill-badge">
        <span class="pulse-dot" style="color: var(--brand-cyan)" aria-hidden="true"></span>
        <span>2026 机场测评 & 状态极客实时监控中</span>
      </div>

      <!-- 核心大标题 (支持 Light 模式深色文本) -->
      <h1 class="hero-cyber-title">
        2026 机场推荐
        <span class="gradient-text-neon hero-cyber-subtitle">科学上网导航</span>
      </h1>

      <!-- 小字描述段落 -->
      <p class="hero-cyber-desc">
        clash-top 用统一维度实测主流机场：晚高峰速度、ChatGPT / Netflix 解锁、线路架构与真实价格，提供 Clash, Shadowrocket 全平台配置教程 完美解锁 Netflix & ChatGPT 流媒体限制。
      </p>

      <!-- 操作按钮组 -->
      <div class="hero-cyber-cta">
        <a href="/brands/" class="btn btn-primary btn-lg" id="hero-cta-primary">
          🏆 查看 2026 机场排行榜
        </a>
        <a href="/compare/" class="btn btn-secondary btn-lg" id="hero-cta-secondary">
          ⚖️ 横向参数对比
        </a>
        <a href="https://t.me/rumors6688" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg" id="hero-cta-tg">
          📢 订阅 TG 频道
        </a>
      </div>

      <!-- 标签点阵 -->
      <div class="hero-tags-row">
        <span class="badge badge-green">✓ 真实自费实测</span>
        <span class="badge badge-cyan">✓ 每周价格复核</span>
        <span class="badge badge-brand">✓ 专线/ANYCAST 收录</span>
        <span class="badge badge-rose">✓ 跑路实时预警</span>
      </div>
    </div>

    <!-- 底部极客雷达网格 (适应 Light / Dark 主题) -->
    <div class="radar-grid">
      <a href="/free-node/" class="card card-hover radar-card">
        <div class="radar-card-icon" style="background: rgba(56, 189, 248, 0.15); color: var(--brand-cyan)">📡</div>
        <div>
          <h3 class="radar-card-title">每日免费节点</h3>
          <p class="radar-card-desc">每天 0 点刷新 · TG 频道推送</p>
        </div>
      </a>

      <a href="/airport-status/" class="card card-hover radar-card">
        <div class="radar-card-icon" style="background: rgba(244, 63, 94, 0.15); color: var(--brand-rose)">🚨</div>
        <div>
          <h3 class="radar-card-title">跑路预警监控</h3>
          <p class="radar-card-desc">状态异动第一时间安全提醒</p>
        </div>
      </a>

      <a href="/brands/" class="card card-hover radar-card">
        <div class="radar-card-icon" style="background: rgba(167, 139, 250, 0.15); color: var(--brand-primary)">⚡</div>
        <div>
          <h3 class="radar-card-title">实测数据库</h3>
          <p class="radar-card-desc">10+ 品牌 · 12 项维度横向考核</p>
        </div>
      </a>

      <a href="/faq/" class="card card-hover radar-card">
        <div class="radar-card-icon" style="background: rgba(52, 211, 153, 0.15); color: var(--brand-green)">💡</div>
        <div>
          <h3 class="radar-card-title">180+ 问题解答</h3>
          <p class="radar-card-desc">排障全覆盖 · 进阶答疑</p>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-cyber {
    position: relative;
    padding-block: 5.5rem 3.5rem;
    overflow: hidden;
  }

  .cyber-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(120, 120, 120, 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.22;
  }
  .orb-1 {
    top: -100px;
    left: 20%;
    width: 350px;
    height: 350px;
    background: var(--brand-primary);
  }
  .orb-2 {
    top: -50px;
    right: 20%;
    width: 300px;
    height: 300px;
    background: var(--brand-cyan);
  }

  .hero-center-content {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--brand-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .hero-cyber-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-main); /* 自动适配 Light/Dark 模式对比度 */
  }

  .hero-cyber-subtitle {
    display: block;
    margin-top: 0.5rem;
  }

  .hero-cyber-desc {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 44rem;
    margin-inline: auto;
    font-weight: 500;
  }

  .hero-cyber-cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.25rem;
  }

  .btn-lg {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    border-radius: var(--radius-lg);
  }

  .hero-tags-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  /* 底部雷达网格 */
  .radar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 4rem;
  }

  .radar-card {
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
  }

  .radar-card-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .radar-card-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .radar-card-desc {
    font-size: 0.75rem;
    color: var(--text-sub);
    margin-top: 0.125rem;
  }
</style>
