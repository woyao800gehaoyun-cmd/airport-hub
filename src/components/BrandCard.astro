---
// src/components/BrandCard.astro — 极客深色品牌卡片
export interface Props {
  id: string;
  name: string;
  avatar: string;
  tagline: string;
  desc: string;
  tags: string[];
  rank: number;
  rankLabel: string;
  priceFrom: string;
  protocol: string;
  nodeCount: string;
  streamUnlock: boolean;
  aiUnlock: boolean;
  trialDays: number;
  score: number;
  url: string;
  slug: string;
}

const { id, name, avatar, tagline, desc, tags, rank, rankLabel, priceFrom, score, slug, url, streamUnlock, aiUnlock, trialDays, protocol, nodeCount } = Astro.props;

const rankColors: Record<number, { bg: string; text: string; label: string }> = {
  1: { bg: 'linear-gradient(135deg, #f59e0b, #d97706)', text: '#ffffff', label: '🥇 主推' },
  2: { bg: 'linear-gradient(135deg, #06b6d4, #0891b2)', text: '#ffffff', label: '🥈 次推' },
  3: { bg: 'linear-gradient(135deg, #8b5cf6, #6d28d9)', text: '#ffffff', label: '🥉 推荐' },
};
const rankStyle = rankColors[rank] ?? { bg: 'rgba(255,255,255,0.08)', text: 'var(--text-muted)', label: `#${rank}` };

const scorePercent = score * 10;
const scoreColor = score >= 9 ? '#34d399' : score >= 8.5 ? '#38bdf8' : '#fbbf24';
---

<div class="cyber-brand-card card card-hover" id={`brand-${id}`} itemscope itemtype="https://schema.org/Product">
  <!-- 卡片顶栏 -->
  <div class="cyber-card-header">
    <span class="cyber-rank-badge" style={`background: ${rankStyle.bg}; color: ${rankStyle.text}`}>
      {rankStyle.label}
    </span>
    <span class="badge badge-brand">{rankLabel}</span>
  </div>

  <!-- 品牌 Logo 行 -->
  <div class="cyber-brand-identity">
    <div class="cyber-avatar" aria-hidden="true">{avatar}</div>
    <div style="min-width: 0">
      <h3 class="cyber-brand-name" itemprop="name">{name}</h3>
      <p class="cyber-brand-tagline">{tagline}</p>
    </div>
  </div>

  <!-- 评分条 -->
  <div class="cyber-score-block">
    <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-muted); margin-bottom:0.375rem">
      <span>综合实测得分</span>
      <span style={`font-weight:700; color:${scoreColor}`}>{score.toFixed(1)} / 10</span>
    </div>
    <div class="cyber-score-track">
      <div class="cyber-score-fill" style={`width:${scorePercent}%; background:${scoreColor}`}></div>
    </div>
  </div>

  <!-- 描述简述 -->
  <p class="cyber-brand-desc line-clamp-2">{desc}</p>

  <!-- 参数极客矩阵 -->
  <div class="cyber-metrics-grid">
    <div class="cyber-metric-item">
      <span class="metric-val">{priceFrom}</span>
      <span class="metric-lab">起步价</span>
    </div>
    <div class="cyber-metric-item">
      <span class="metric-val" style="font-size:0.75rem">{protocol.split('+')[0].trim()}</span>
      <span class="metric-lab">协议</span>
    </div>
    <div class="cyber-metric-item">
      <span class="metric-val">{nodeCount}</span>
      <span class="metric-lab">节点数</span>
    </div>
    <div class="cyber-metric-item">
      <span class="metric-val">{trialDays > 0 ? `${trialDays}天` : '无试用'}</span>
      <span class="metric-lab">免费试用</span>
    </div>
  </div>

  <!-- 解锁状态标签 -->
  <div class="cyber-unlock-tags">
    <span class={`unlock-pill ${streamUnlock ? 'on' : 'off'}`}>
      {streamUnlock ? '✓' : '✗'} Netflix
    </span>
    <span class={`unlock-pill ${aiUnlock ? 'on' : 'off'}`}>
      {aiUnlock ? '✓' : '✗'} ChatGPT
    </span>
    <span class={`unlock-pill ${streamUnlock ? 'on' : 'off'}`}>
      {streamUnlock ? '✓' : '✗'} YouTube 4K
    </span>
  </div>

  <!-- 底部双按钮 -->
  <div class="cyber-card-actions">
    <a href={`/brands/${slug}/`} class="btn btn-secondary" style="flex: 1; padding: 0.5rem" id={`brand-detail-${id}`}>
      测评详情
    </a>
    {url !== '#' ? (
      <a
        href={url}
        target="_blank"
        rel="noopener nofollow sponsored"
        class="btn btn-primary"
        style="flex: 1; padding: 0.5rem"
        id={`brand-goto-${id}`}
      >
        官网注册 →
      </a>
    ) : (
      <span class="btn" style="flex: 1; padding: 0.5rem; background: rgba(255,255,255,0.04); color: var(--text-sub); border: 1px solid var(--border-color); cursor: not-allowed">
        暂未收录
      </span>
    )}
  </div>
</div>

<style>
  .cyber-brand-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .cyber-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .cyber-rank-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .cyber-brand-identity {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .cyber-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(6, 182, 212, 0.2));
    border: 1px solid rgba(139, 92, 246, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
    color: #c084fc;
    flex-shrink: 0;
  }

  .cyber-brand-name {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .cyber-brand-tagline {
    font-size: 0.75rem;
    color: var(--text-sub);
    margin-top: 0.125rem;
  }

  .cyber-score-block {
    margin-top: 1rem;
  }

  .cyber-score-track {
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .cyber-score-fill {
    height: 100%;
    border-radius: 3px;
  }

  .cyber-brand-desc {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cyber-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.375rem;
    margin-top: 1rem;
    padding: 0.625rem;
    background: rgba(0, 0, 0, 0.25);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
  }

  .cyber-metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-val {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .metric-lab {
    font-size: 0.65rem;
    color: var(--text-sub);
    margin-top: 0.125rem;
  }

  .cyber-unlock-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }

  .unlock-pill {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .unlock-pill.on {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.25);
  }

  .unlock-pill.off {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-sub);
    border-color: rgba(255, 255, 255, 0.05);
    text-decoration: line-through;
  }

  .cyber-card-actions {
    display: flex;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }
</style>
